---
// Grid + floating-text background — inspired by Qclaw
---

<canvas
  id="geo-bg"
  aria-hidden="true"
  transition:persist="geo-canvas"
  style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"
></canvas>

<script is:inline>
(function () {
  if (window.__geoBgRunning) return;
  window.__geoBgRunning = true;

  /* ── phrases ──────────────────────────────────────────────── */
  const PHRASES = [
    'building beautiful interfaces',
    'writing clean code',
    'design meets function',
    'crafting user experiences',
    'pixel perfect layouts',
    'ship it with care',
    'attention to detail',
    'elegant solutions',
    'the art of simplicity',
    'code is poetry',
    'responsive by nature',
    'through the lens',
    'moments worth keeping',
    'light and composition',
    'life in focus',
    'visual storytelling',
    'frontend development',
    'capturing the perfect shot',
    'creative direction',
    'form follows function',
    'every pixel matters',
    'stay curious',
    'iterate and improve',
    'beauty in the details',
  ];

  /* ── palette ──────────────────────────────────────────────── */
  const THEMES = {
    light: {
      gridColor:  'rgba(148, 90, 48, 0.045)',
      textColor:  'rgba(120, 72, 36, 1)',
      textAlpha:  0.17,
      gridGap:    60,
    },
    dark: {
      gridColor:  'rgba(200, 125, 85, 0.055)',
      textColor:  'rgba(205, 128, 88, 1)',
      textAlpha:  0.22,
      gridGap:    60,
    },
  };

  /* ── config ───────────────────────────────────────────────── */
  const TEXT_COUNT  = 18;
  const FONT_SIZE   = 11.5;
  const FONT        = `${FONT_SIZE}px 'JetBrains Mono', ui-monospace, monospace`;
  const FADE_ZONE   = 0.18;   /* fraction of H for fade in/out   */

  /* ── state ────────────────────────────────────────────────── */
  const canvas = document.getElementById('geo-bg');
  const ctx    = canvas.getContext('2d');
  let W = 0, H = 0, raf = null;
  let palette = THEMES.light;
  let particles = [];
  let lastW = 0, resizeTimer = null;

  /* ── theme ────────────────────────────────────────────────── */
  function syncPalette () {
    palette = document.documentElement.getAttribute('data-theme') === 'dark'
      ? THEMES.dark : THEMES.light;
  }

  /* ── TextParticle ─────────────────────────────────────────── */
  class TextParticle {
    constructor (initial) {
      this.init(initial);
    }
    init (initial) {
      this.text  = PHRASES[Math.floor(Math.random() * PHRASES.length)];
      this.x     = Math.random() * (W + 200) - 100;
      this.y     = initial ? Math.random() * H : H + FONT_SIZE * 2;
      this.speed = 0.25 + Math.random() * 0.35;
    }
    update () {
      this.y -= this.speed;
      if (this.y < -FONT_SIZE * 2) this.init(false);
    }
    alpha () {
      const fadeIn  = H * FADE_ZONE;
      const fadeOut = H * FADE_ZONE;
      if (this.y > H - fadeIn)  return Math.max(0, 1 - (this.y - (H - fadeIn))  / fadeIn);
      if (this.y < fadeOut)     return Math.max(0, this.y / fadeOut);
      return 1;
    }
  }

  /* ── resize ───────────────────────────────────────────────── */
  function applyResize () {
    const newW = window.innerWidth;
    const newH = window.innerHeight;
    canvas.width  = W = newW;
    canvas.height = H = newH;
    /* 只在宽度发生明显变化（横竖屏切换 / 真实窗口缩放）时重建粒子，
       移动端上下滑动仅触发高度变化（地址栏显隐），跳过重建避免粒子爆炸 */
    if (!particles.length || Math.abs(newW - lastW) > 30) {
      lastW = newW;
      particles = Array.from({ length: TEXT_COUNT }, () => new TextParticle(true));
    }
  }

  function resize () {
    /* 防抖：100ms 内只执行一次，消除移动端高频 resize 事件 */
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(applyResize, 100);
  }

  /* ── draw grid ────────────────────────────────────────────── */
  function drawGrid () {
    const g = palette.gridGap;
    ctx.strokeStyle = palette.gridColor;
    ctx.lineWidth   = 1;
    ctx.globalAlpha = 1;
    ctx.beginPath();
    for (let x = 0; x <= W; x += g) {
      ctx.moveTo(x + 0.5, 0);
      ctx.lineTo(x + 0.5, H);
    }
    for (let y = 0; y <= H; y += g) {
      ctx.moveTo(0, y + 0.5);
      ctx.lineTo(W, y + 0.5);
    }
    ctx.stroke();
  }

  /* ── draw loop ────────────────────────────────────────────── */
  function draw () {
    ctx.clearRect(0, 0, W, H);

    drawGrid();

    ctx.font      = FONT;
    ctx.fillStyle = palette.textColor;
    ctx.textBaseline = 'top';

    for (const p of particles) {
      p.update();
      const a = p.alpha() * palette.textAlpha;
      if (a < 0.003) continue;
      ctx.globalAlpha = a;
      ctx.fillText(p.text, p.x, p.y);
    }

    ctx.globalAlpha = 1;
    raf = requestAnimationFrame(draw);
  }

  /* ── theme observer ───────────────────────────────────────── */
  new MutationObserver(syncPalette).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });

  /* ── Astro view-transitions ───────────────────────────────── */
  document.addEventListener('astro:before-swap', () => {
    if (raf) { cancelAnimationFrame(raf); raf = null; }
  });
  document.addEventListener('astro:after-swap', () => {
    syncPalette();
    if (!raf) raf = requestAnimationFrame(draw);
  });

  /* ── boot ─────────────────────────────────────────────────── */
  syncPalette();
  applyResize();                          /* 首次直接执行，无需防抖 */
  window.addEventListener('resize', resize);
  raf = requestAnimationFrame(draw);
})();
</script>
