---
// Geometric canvas background — adapts to light / dark theme
---

<!-- inline styles bypass Astro CSS scoping, safe with transition:persist -->
<canvas
  id="geo-bg"
  aria-hidden="true"
  transition:persist="geo-canvas"
  style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"
></canvas>

<script is:inline>
(function () {

  /* ── guard: don't double-init if script re-runs on navigation ── */
  if (window.__geoBgRunning) return;
  window.__geoBgRunning = true;

  /* ─── palette ──────────────────────────────────────────────── */
  const THEMES = {
    light: {
      stroke:      'rgba(118, 70, 36, 0.9)',
      lineAlpha:   0.32,
      lineWidth:   0.70,
      nodeColor:   'rgba(118, 70, 36, 0.42)',
      nodeRadius:  1.4,
      shadowBlur:  0,
      shadowColor: 'transparent',
    },
    dark: {
      stroke:      'rgba(212, 124, 90, 0.9)',
      lineAlpha:   0.52,
      lineWidth:   0.70,
      nodeColor:   'rgba(212, 124, 90, 0.65)',
      nodeRadius:  1.4,
      shadowBlur:  5,
      shadowColor: 'rgba(210, 110, 75, 0.30)',
    },
  };

  /* ─── config ───────────────────────────────────────────────── */
  const NODE_COUNT = 60;
  const LINK_DIST  = 190;
  const BOW_AMP    = 22;    /* max bezier bow in px               */
  const BOW_SPEED  = 0.28;  /* bow oscillation speed              */

  /* ─── state ────────────────────────────────────────────────── */
  const canvas = document.getElementById('geo-bg');
  const ctx    = canvas.getContext('2d');
  let W = 0, H = 0;
  let nodes    = [];
  let raf      = null;
  let palette  = THEMES.light;

  /* ─── theme ────────────────────────────────────────────────── */
  function syncPalette () {
    palette = document.documentElement.getAttribute('data-theme') === 'dark'
      ? THEMES.dark : THEMES.light;
  }

  /* ─── Node ─────────────────────────────────────────────────── */
  class Node {
    constructor () {
      this.x     = Math.random() * W;
      this.y     = Math.random() * H;
      this.angle = Math.random() * Math.PI * 2;
      this.angVel = (Math.random() - 0.5) * 0.005;
      this.speed  = 0.08 + Math.random() * 0.14;
      this.phase  = Math.random() * Math.PI * 2;
    }
    update (t) {
      this.angle += this.angVel;
      const s = this.speed * (1 + 0.15 * Math.sin(t * 0.55 + this.phase));
      this.x += Math.cos(this.angle) * s;
      this.y += Math.sin(this.angle) * s;
      const P = 32;
      if (this.x < -P) this.x = W + P;
      else if (this.x > W + P) this.x = -P;
      if (this.y < -P) this.y = H + P;
      else if (this.y > H + P) this.y = -P;
    }
  }

  /* ─── resize ───────────────────────────────────────────────── */
  function resize () {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
    nodes = Array.from({ length: NODE_COUNT }, () => new Node());
  }

  /* ─── draw ─────────────────────────────────────────────────── */
  function draw (ts) {
    const t   = (ts || 0) * 0.001;
    const LD2 = LINK_DIST * LINK_DIST;

    ctx.clearRect(0, 0, W, H);
    for (const n of nodes) n.update(t);

    /* ── lines ── */
    ctx.strokeStyle = palette.stroke;
    ctx.lineWidth   = palette.lineWidth;
    ctx.lineCap     = 'round';
    ctx.shadowColor = palette.shadowColor;
    ctx.shadowBlur  = palette.shadowBlur;

    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const dx = nodes[j].x - nodes[i].x;
        const dy = nodes[j].y - nodes[i].y;
        const d2 = dx * dx + dy * dy;
        if (d2 >= LD2) continue;

        const dist = Math.sqrt(d2);
        const tn   = dist / LINK_DIST;           /* 0=close  1=edge */

        /* quadratic falloff — visible through mid-range */
        ctx.globalAlpha = (1 - tn) * (1 - tn) * palette.lineAlpha;

        /* bezier control point: perpendicular bow, per-pair phase */
        const mx = (nodes[i].x + nodes[j].x) * 0.5;
        const my = (nodes[i].y + nodes[j].y) * 0.5;
        const nx = -dy / dist;
        const ny =  dx / dist;
        const ph = (i * 7.391 + j * 13.718) % (Math.PI * 2);
        const bw = Math.sin(t * BOW_SPEED + ph) * BOW_AMP * (1 - tn * 0.5);

        ctx.beginPath();
        ctx.moveTo(nodes[i].x, nodes[i].y);
        ctx.quadraticCurveTo(mx + nx * bw, my + ny * bw, nodes[j].x, nodes[j].y);
        ctx.stroke();
      }
    }

    /* ── nodes ── */
    ctx.shadowBlur  = 0;
    ctx.fillStyle   = palette.nodeColor;
    ctx.globalAlpha = 1;
    for (const n of nodes) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, palette.nodeRadius, 0, Math.PI * 2);
      ctx.fill();
    }

    raf = requestAnimationFrame(draw);
  }

  /* ─── theme observer ───────────────────────────────────────── */
  new MutationObserver(syncPalette).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });

  /* ─── Astro view-transitions ───────────────────────────────── */
  document.addEventListener('astro:before-swap', () => {
    if (raf) { cancelAnimationFrame(raf); raf = null; }
  });
  document.addEventListener('astro:after-swap', () => {
    syncPalette();
    if (!raf) raf = requestAnimationFrame(draw);
  });

  /* ─── boot ─────────────────────────────────────────────────── */
  syncPalette();
  resize();
  window.addEventListener('resize', resize);
  raf = requestAnimationFrame(draw);

})();
</script>
