---
import NavBar from '../components/NavBar.vue';
import ThemeToggle from '../components/ThemeToggle.vue';
import BackToTop from '../components/BackToTop.vue';
import GeometricBackground from '../components/GeometricBackground.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const siteTitle = "Momoc's Blog";
const { title, description = "前端开发 · 摄影 · 生活" } = Astro.props;
const pageTitle = title && title !== siteTitle ? `${title} | ${siteTitle}` : siteTitle;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<ClientRouter fallback="swap" />
		<link rel="preconnect" href="https://PEKHQFSYYO-dsn.algolia.net" crossorigin>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<!-- 主题初始化 - 在渲染前执行防止闪烁 -->
		<script is:inline>
			window.applyTheme = function() {
				const savedTheme = localStorage.getItem('theme');
				const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
				document.documentElement.setAttribute('data-theme', theme);
			};
			window.applyTheme();
			if (!window.__themeAfterSwapListener) {
				document.addEventListener('astro:after-swap', () => window.applyTheme());
				window.__themeAfterSwapListener = true;
			}
		</script>
	</head>
	<body>
		<GeometricBackground />
		<div class="layout">
			<NavBar currentPath={currentPath} client:load transition:persist="site-header">
				<ThemeToggle slot="actions" client:load />
			</NavBar>

			<main class="main">
				<slot />
			</main>

			<BackToTop client:load transition:persist="back-to-top" />

			<!-- Footer — 深海军蓝 -->
			<footer class="footer">
				<div class="footer-container">
					<div class="footer-brand">
						<svg class="footer-mark" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
							<path d="M9 1.5V16.5M1.5 9H16.5M3.697 3.697L14.303 14.303M14.303 3.697L3.697 14.303" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
						</svg>
						<span class="footer-logo-text">Momoc's Blog</span>
					</div>
					<p class="footer-copy">
						© {new Date().getFullYear()} · Built with
						<a href="https://astro.build" target="_blank" rel="noopener" class="footer-link">Astro</a>
					</p>
					<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="footer-beian">
						粤ICP备2025366790号-1
					</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	/* ============================================
	   DESIGN SYSTEM — CLAUDE.COM / ANTHROPIC STYLE
	   ============================================ */

	:root {
		/* ── Brand ── */
		--c-primary:          #cc785c;
		--c-primary-active:   #a9583e;
		--c-primary-disabled: #e6dfd8;

		/* ── Surfaces (Light) ── */
		--c-canvas:              #faf9f5;
		--c-surface-soft:        #f5f0e8;
		--c-surface-card:        #efe9de;
		--c-surface-cream-strong:#e8e0d2;
		--c-surface-dark:        #181715;
		--c-surface-dark-elevated:#252320;
		--c-surface-dark-soft:   #1f1e1b;

		/* ── Text (Light) ── */
		--c-ink:         #141413;
		--c-body:        #3d3d3a;
		--c-body-strong: #252523;
		--c-muted:       #6c6a64;
		--c-muted-soft:  #8e8b82;
		--c-on-primary:  #ffffff;
		--c-on-dark:     #faf9f5;
		--c-on-dark-soft:#a09d96;

		/* ── Borders ── */
		--c-hairline:     #e6dfd8;
		--c-hairline-soft:#ebe6df;

		/* ── Accent ── */
		--c-teal:    #5db8a6;
		--c-amber:   #e8a55a;
		--c-success: #5db872;
		--c-warning: #d4a017;
		--c-error:   #c64545;

		/* ── vp-c-* 兼容映射（供组件继续使用） ── */
		--vp-c-bg:       var(--c-canvas);
		--vp-c-bg-alt:   var(--c-surface-soft);
		--vp-c-bg-elv:   var(--c-surface-card);
		--vp-c-bg-soft:  var(--c-surface-soft);
		--vp-c-text-1:   var(--c-ink);
		--vp-c-text-2:   var(--c-body);
		--vp-c-text-3:   var(--c-muted);
		--vp-c-divider:  var(--c-hairline-soft);
		--vp-c-border:   var(--c-hairline);
		--vp-c-brand-1:  var(--c-primary);
		--vp-c-brand-2:  var(--c-primary-active);
		--vp-c-brand-3:  #894432;
		--vp-c-brand-soft: rgba(204, 120, 92, 0.1);
		--vp-shadow-1: 0 1px 3px rgba(20,20,19,0.06);
		--vp-shadow-2: 0 1px 3px rgba(20,20,19,0.08);
		--vp-shadow-3: 0 4px 24px rgba(20,20,19,0.07);

		/* ── Typography ── */
		--font-display: 'Cormorant Garamond', 'Tiempos Headline', 'EB Garamond', Georgia, serif;
		--font-body:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--font-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		--vp-font-family-base: var(--font-body);
		--vp-font-family-mono: var(--font-mono);

		--header-height: 64px;
	}

	/* ── Dark Theme ── */
	[data-theme="dark"] {
		--c-canvas:              #181715;
		--c-surface-soft:        #1f1e1b;
		--c-surface-card:        #252320;
		--c-surface-cream-strong:#2e2c29;
		--c-surface-dark:        #111010;
		--c-surface-dark-elevated:#1a1917;
		--c-surface-dark-soft:   #161513;

		--c-ink:         #faf9f5;
		--c-body:        #a09d96;
		--c-body-strong: #d4d0c8;
		--c-muted:       #6c6a64;
		--c-muted-soft:  #504e49;
		--c-on-dark:     #faf9f5;
		--c-on-dark-soft:#a09d96;

		--c-hairline:     rgba(250,249,245,0.12);
		--c-hairline-soft:rgba(250,249,245,0.07);

		--vp-c-bg:      #181715;
		--vp-c-bg-alt:  #1f1e1b;
		--vp-c-bg-elv:  #252320;
		--vp-c-bg-soft: #1f1e1b;
		--vp-c-text-1:  #faf9f5;
		--vp-c-text-2:  #a09d96;
		--vp-c-text-3:  #6c6a64;
		--vp-c-divider: rgba(250,249,245,0.07);
		--vp-c-border:  rgba(250,249,245,0.12);
		--vp-c-brand-soft: rgba(204,120,92,0.15);
	}

	/* ── Reset ── */
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background-color: var(--c-canvas);
		color: var(--c-ink);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		transition: background-color 0.3s, color 0.3s;
	}

	.layout {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	.main {
		flex: 1;
		margin-top: var(--header-height);
	}

	/* ── Footer ── */
	.footer {
		background-color: #181715; /* 始终深色，不跟随主题 */
		padding: 48px 0 40px;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
		text-align: center;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 18px;
	}

	.footer-mark {
		color: rgba(250,249,245,0.5);
	}

	.footer-logo-text {
		font-size: 0.9375rem;
		font-weight: 500;
		color: #faf9f5;
		letter-spacing: -0.01em;
	}

	.footer-copy {
		font-size: 0.875rem;
		color: #a09d96;
		margin-bottom: 8px;
	}

	.footer-link {
		color: var(--c-primary);
		text-decoration: none;
	}

	.footer-link:hover {
		opacity: 0.8;
	}

	.footer-beian {
		display: inline-block;
		font-size: 0.8125rem;
		color: #504e49;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-beian:hover {
		color: #a09d96;
	}

	/* ── Shiki 代码高亮双主题 ── */
	[data-theme="dark"] .astro-code {
		background-color: var(--shiki-dark-bg) !important;
	}
	[data-theme="dark"] .astro-code span {
		color: var(--shiki-dark) !important;
	}
</style>
