---
import Layout from '../layouts/Layout.astro';

const title = "关于";
const description = "了解更多关于博主的信息";
const avatarUrl = "https://image.momoc.cn/common/avatar.png";

const skills = [
	{ name: "Astro", level: 90 },
	{ name: "TypeScript", level: 85 },
	{ name: "Vue.js", level: 88 },
	{ name: "Node.js", level: 80 },
	{ name: "GitHub Actions", level: 75 },
];

const socialLinks = [
	{
		name: "GitHub",
		url: "https://github.com/Skyrim-Tom",
		icon: "github"
	},
	{
		name: "Twitter",
		url: "https://twitter.com",
		icon: "twitter"
	},
	{
		name: "Email",
		url: "mailto:hello@example.com",
		icon: "email"
	}
];

// Lucide 图标 SVG
const icons: Record<string, string> = {
	github: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
	twitter: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
	email: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	user: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
	layers: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>`,
	arrowUpRight: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>`,
	heart: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
	camera: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>`,
	sparkles: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`
};
---

<Layout title={title} description={description}>
	<div class="about-page">
		<!-- Hero Section -->
		<section class="about-hero">
			<div class="hero-container">
				<div class="profile-section">
					<div class="avatar-wrapper">
						<div class="avatar">
							<img src={avatarUrl} alt="Momoc" class="avatar-img" />
						</div>
						<div class="avatar-ring"></div>
					</div>
					<div class="profile-info">
						<h1 class="profile-name">Momoc</h1>
						<p class="profile-role">前端开发者 / 摄影爱好者</p>
						<div class="profile-tags">
							<span class="profile-tag">
								<span class="tag-icon" set:html={icons.sparkles} />
								热爱技术
							</span>
							<span class="profile-tag">
								<span class="tag-icon" set:html={icons.heart} />
								记录生活
							</span>
							<span class="profile-tag">
								<span class="tag-icon" set:html={icons.camera} />
								分享摄影
							</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Grid -->
		<div class="content-grid">
			<!-- Main Content -->
			<div class="main-content">
				<!-- About Section -->
				<section class="content-section">
					<div class="section-header">
						<div class="section-icon-wrapper" set:html={icons.user} />
						<h2 class="section-title">关于我</h2>
					</div>
					<div class="section-body">
						<p>
							欢迎来到我的博客！我是一名热爱技术的前端开发者，专注于现代 Web 开发技术。
							在这里，我会分享我的技术学习心得、项目实战经验以及生活感悟。
						</p>
						<p>
							除了编程，我还热爱摄影，喜欢用镜头记录生活中的美好瞬间。
							这个博客使用 <strong>Astro</strong> 框架构建，部署在阿里云服务器上，
							通过 <strong>GitHub Actions</strong> 实现自动化部署。
						</p>
					</div>
				</section>

				<!-- Skills Section -->
				<section class="content-section">
					<div class="section-header">
						<div class="section-icon-wrapper" set:html={icons.layers} />
						<h2 class="section-title">技术栈</h2>
					</div>
					<div class="skills-list">
						{skills.map((skill) => (
							<div class="skill-item">
								<div class="skill-info">
									<span class="skill-name">{skill.name}</span>
									<span class="skill-level">{skill.level}%</span>
								</div>
								<div class="skill-bar">
									<div class="skill-progress" style={`width: ${skill.level}%`}></div>
								</div>
							</div>
						))}
					</div>
				</section>
			</div>

			<!-- Sidebar -->
			<aside class="sidebar">
				<!-- Connect Section -->
				<div class="sidebar-section">
					<h3 class="sidebar-title">联系方式</h3>
					<div class="social-links">
						{socialLinks.map((link) => (
							<a href={link.url} target="_blank" rel="noopener noreferrer" class="social-link">
								<span class="social-icon" set:html={icons[link.icon]} />
								<span class="social-name">{link.name}</span>
								<span class="social-arrow" set:html={icons.arrowUpRight} />
							</a>
						))}
					</div>
				</div>

				<!-- Stats Section -->
				<div class="sidebar-section">
					<h3 class="sidebar-title">数据统计</h3>
					<div class="stats-grid">
						<div class="stat-box">
							<span class="stat-number">5+</span>
							<span class="stat-label">年开发经验</span>
						</div>
						<div class="stat-box">
							<span class="stat-number">20+</span>
							<span class="stat-label">技术文章</span>
						</div>
						<div class="stat-box">
							<span class="stat-number">100+</span>
							<span class="stat-label">摄影作品</span>
						</div>
					</div>
				</div>
			</aside>
		</div>
	</div>
</Layout>

<style>
	.about-page {
		padding-bottom: 64px;
	}

	/* Hero Section */
	.about-hero {
		background: linear-gradient(180deg, var(--vp-c-bg-alt) 0%, var(--vp-c-bg) 100%);
		padding: 64px 24px;
		border-bottom: 1px solid var(--vp-c-divider);
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.profile-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.avatar-wrapper {
		position: relative;
		margin-bottom: 24px;
	}

	.avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--vp-c-brand-1) 0%, var(--vp-c-brand-2) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}

	.avatar-ring {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 2px solid var(--vp-c-brand-1);
		opacity: 0.3;
		animation: pulse-ring 3s ease-in-out infinite;
	}

	@keyframes pulse-ring {
		0%, 100% { transform: scale(1); opacity: 0.3; }
		50% { transform: scale(1.05); opacity: 0.5; }
	}

	.profile-name {
		font-size: 2rem;
		font-weight: 700;
		color: var(--vp-c-text-1);
		margin-bottom: 8px;
	}

	.profile-role {
		font-size: 1.125rem;
		color: var(--vp-c-text-2);
		margin-bottom: 16px;
	}

	.profile-tags {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.profile-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.875rem;
		color: var(--vp-c-brand-1);
		font-weight: 500;
	}
	
	.tag-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
	}
	
	.tag-icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	/* Content Grid */
	.content-grid {
		max-width: 1000px;
		margin: 0 auto;
		padding: 48px 24px;
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 48px;
	}

	/* Content Section */
	.content-section {
		background: var(--vp-c-bg-elv);
		border: 1px solid var(--vp-c-divider);
		border-radius: 12px;
		padding: 32px;
		margin-bottom: 24px;
	}

	.content-section:last-child {
		margin-bottom: 0;
	}

	.section-header {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 20px;
	}

	.section-icon-wrapper {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		background: var(--vp-c-brand-soft);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--vp-c-brand-1);
	}

	.section-icon-wrapper :global(svg) {
		width: 20px;
		height: 20px;
	}

	.section-title {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--vp-c-text-1);
	}

	.section-body {
		color: var(--vp-c-text-2);
		line-height: 1.8;
	}

	.section-body p {
		margin-bottom: 16px;
	}

	.section-body p:last-child {
		margin-bottom: 0;
	}

	.section-body strong {
		color: var(--vp-c-text-1);
		font-weight: 600;
	}

	/* Skills */
	.skills-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.skill-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.skill-info {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.skill-name {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--vp-c-text-1);
	}

	.skill-level {
		font-size: 0.875rem;
		color: var(--vp-c-text-3);
	}

	.skill-bar {
		height: 6px;
		background: var(--vp-c-bg-soft);
		border-radius: 3px;
		overflow: hidden;
	}

	.skill-progress {
		height: 100%;
		background: linear-gradient(90deg, var(--vp-c-brand-1) 0%, var(--vp-c-brand-2) 100%);
		border-radius: 3px;
		transition: width 0.5s ease;
	}

	/* Sidebar */
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.sidebar-section {
		background: var(--vp-c-bg-elv);
		border: 1px solid var(--vp-c-divider);
		border-radius: 12px;
		padding: 24px;
	}

	.sidebar-title {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--vp-c-text-1);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 16px;
	}

	/* Social Links */
	.social-links {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px;
		border-radius: 8px;
		color: var(--vp-c-text-1);
		text-decoration: none;
		transition: all 0.2s;
	}

	.social-link:hover {
		background: var(--vp-c-bg-soft);
	}

	.social-icon {
		width: 20px;
		height: 20px;
		color: var(--vp-c-text-2);
	}

	.social-icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.social-name {
		flex: 1;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.social-arrow {
		width: 16px;
		height: 16px;
		color: var(--vp-c-text-3);
		transition: all 0.2s;
	}

	.social-link:hover .social-arrow {
		color: var(--vp-c-brand-1);
		transform: translate(2px, -2px);
	}

	/* Stats Grid */
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		gap: 12px;
	}

	.stat-box {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px;
		background: var(--vp-c-bg-soft);
		border-radius: 8px;
		text-align: center;
	}

	.stat-number {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--vp-c-brand-1);
	}

	.stat-label {
		font-size: 0.8125rem;
		color: var(--vp-c-text-2);
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.content-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.sidebar {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.about-hero {
			padding: 48px 16px;
		}

		.avatar {
			width: 100px;
			height: 100px;
		}

		.avatar-img {
			width: 100%;
			height: 100%;
			border-radius: 50%;
			object-fit: cover;
		}

		.profile-name {
			font-size: 1.5rem;
		}

		.content-grid {
			padding: 32px 16px;
		}

		.content-section {
			padding: 24px;
		}

		.sidebar {
			grid-template-columns: 1fr;
		}
	}
</style>
