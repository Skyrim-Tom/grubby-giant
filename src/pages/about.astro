---
import Layout from '../layouts/Layout.astro';

const title = "关于";
const description = "了解更多关于我的信息——前端开发者，摄影爱好者";

const skills = [
	"Codex / Cursor", "AI Agent", "Vue3", "TypeScript",
	"JavaScript / ES2015+", "Astro", "Pinia", "Vite",
	"Webpack", "Ant Design Vue", "qiankun", "Taro",
	"uni-app", "微信 / 支付宝小程序", "Node.js", "Express",
	"MongoDB", "HTTP / HTTPS", "Web 性能优化", "Git / GitHub",
	"GitHub Actions", "CI/CD", "Linux / Nginx", "Photography",
];

const socialLinks = [
	{
		name: "GitHub",
		handle: "@Skyrim-Tom",
		url: "https://github.com/Skyrim-Tom",
		iconPath: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
	},
	{
		name: "Twitter",
		handle: "@Momoc",
		url: "https://twitter.com",
		iconPath: `<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>`,
	},
	{
		name: "Email",
		handle: "1005875085@qq.com",
		url: "mailto:1005875085@qq.com",
		iconPath: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
	},
];

const stats = [
	{ value: "7年+", label: "开发经验" },
	{ value: "20+",  label: "技术文章" },
	{ value: "100+", label: "摄影作品" },
];
---

<Layout title={title} description={description}>
<div class="about">

	<!-- ════════════════════════════════════════
	     HERO — 奶油画布，左文右深色卡片
	     ════════════════════════════════════════ -->
	<section class="hero">
		<div class="hero-inner">

			<!-- 左：Bio 区 -->
			<div class="hero-bio">
				<div class="hero-eyebrow">
					<span class="eyebrow-mark" aria-hidden="true">✦</span>
					<span>ABOUT ME</span>
				</div>

				<h1 class="hero-name">Momoc</h1>
				<p class="hero-role">前端开发者 · 摄影爱好者</p>

				<p class="hero-desc">
					欢迎来到我的博客。我是一名专注于现代 Web 开发技术的前端工程师，
					在这里分享技术积累、项目经验与生活感悟。
					除了编程，我同样热爱摄影，喜欢用镜头定格生活里的美好瞬间。
				</p>

				<!-- 社交按钮 -->
				<div class="hero-socials">
					{socialLinks.map(link => (
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="social-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
								stroke="currentColor" stroke-width="2"
								stroke-linecap="round" stroke-linejoin="round"
								aria-hidden="true" set:html={link.iconPath}
							/>
							<span>{link.name}</span>
						</a>
					))}
				</div>
			</div>

			<!-- 右：深色 Profile 卡片 -->
			<div class="profile-card" aria-label="个人信息卡片">
				<div class="profile-avatar">
					<img
						src="https://image.momoc.cn/common/avatar.png"
						alt="Momoc 的头像"
						width="80"
						height="80"
					/>
				</div>
				<div class="profile-identity">
					<strong class="profile-name">Momoc</strong>
					<span class="profile-subtitle">Front-end Developer</span>
				</div>
				<div class="profile-divider" aria-hidden="true"></div>
				<div class="stats-row">
					{stats.map(s => (
						<div class="stat">
							<span class="stat-value">{s.value}</span>
							<span class="stat-label">{s.label}</span>
						</div>
					))}
				</div>
				<div class="profile-status">
					<span class="status-dot" aria-hidden="true"></span>
					<span>Located in China</span>
				</div>
			</div>

		</div>
	</section>

	<!-- ════════════════════════════════════════
	     SKILLS — 柔奶油背景 + 技能 Pill
	     ════════════════════════════════════════ -->
	<section class="skills-section">
		<div class="skills-inner">
			<div class="section-eyebrow">
				<span class="eyebrow-mark" aria-hidden="true">✦</span>
				<span>SKILLS &amp; TOOLS</span>
			</div>
			<h2 class="section-heading">技术栈</h2>
			<div class="skills-grid" role="list" aria-label="技能列表">
				{skills.map(skill => (
					<span class="skill-pill" role="listitem">{skill}</span>
				))}
			</div>
		</div>
	</section>

	<!-- ════════════════════════════════════════
	     CODE CARD — 奶油背景 + 深色终端风
	     ════════════════════════════════════════ -->
	<section class="code-section">
		<div class="code-inner">
			<div class="code-card" aria-label="开发者信息代码示例">
				<!-- 窗口标题栏 -->
				<div class="code-header">
					<div class="code-dots" aria-hidden="true">
						<span class="dot dot-red"></span>
						<span class="dot dot-yellow"></span>
						<span class="dot dot-green"></span>
					</div>
					<span class="code-filename">developer.ts</span>
				</div>
				<!-- 代码体 -->
				<pre class="code-body"><code><span class="t-kw">const</span> <span class="t-var">developer</span> <span class="t-op">=</span> &#123;
  <span class="t-key">name</span><span class="t-punc">:</span>       <span class="t-str">"Momoc"</span><span class="t-punc">,</span>
  <span class="t-key">role</span><span class="t-punc">:</span>       <span class="t-str">"Frontend Developer"</span><span class="t-punc">,</span>
  <span class="t-key">location</span><span class="t-punc">:</span>   <span class="t-str">"China 🇨🇳"</span><span class="t-punc">,</span>
  <span class="t-key">passion</span><span class="t-punc">:</span>    <span class="t-bracket">[</span><span class="t-str">"Web Dev"</span><span class="t-punc">,</span> <span class="t-str">"Photography"</span><span class="t-bracket">]</span><span class="t-punc">,</span>
  <span class="t-key">blog</span><span class="t-punc">:</span>       <span class="t-str">"www.momoc.cn"</span><span class="t-punc">,</span>
  <span class="t-key">available</span><span class="t-punc">:</span>  <span class="t-bool">true</span><span class="t-punc">,</span>
&#125;</code></pre>
			</div>
		</div>
	</section>

	<!-- ════════════════════════════════════════
	     CONTACT CTA — 珊瑚色全幅卡片
	     ════════════════════════════════════════ -->
	<section class="contact-section">
		<div class="contact-inner">
			<div class="contact-card">

				<div class="contact-left">
					<h2 class="contact-title">想要合作或联系我？</h2>
					<p class="contact-desc">
						欢迎通过以下方式找到我，随时期待交流与合作。
					</p>
				</div>

				<div class="contact-links" role="list" aria-label="联系方式列表">
					{socialLinks.map(link => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="contact-link"
							role="listitem"
						>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
								stroke="currentColor" stroke-width="2"
								stroke-linecap="round" stroke-linejoin="round"
								aria-hidden="true" set:html={link.iconPath}
							/>
							<span class="contact-link-info">
								<span class="contact-link-name">{link.name}</span>
								<span class="contact-link-handle">{link.handle}</span>
							</span>
							<svg class="contact-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M7 7h10v10M7 17L17 7"/>
							</svg>
						</a>
					))}
				</div>

			</div>
		</div>
	</section>

</div>
</Layout>

<style>
/* ── Hero ── */
.hero {
	padding: 96px 24px 88px;
}

.hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	display: grid;
	grid-template-columns: 1fr auto;
	gap: 80px;
	align-items: start;
}

.hero-eyebrow,
.section-eyebrow {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	font-size: 0.6875rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	color: var(--c-muted);
	margin-bottom: 20px;
}

.eyebrow-mark {
	color: var(--c-primary);
}

.hero-name {
	font-family: var(--font-display);
	font-size: clamp(2.75rem, 5vw, 4rem);
	font-weight: 400;
	line-height: 1.05;
	letter-spacing: -0.05em;
	color: var(--c-ink);
	margin-bottom: 8px;
}

.hero-role {
	font-size: 1.0625rem;
	color: var(--c-muted);
	font-weight: 500;
	margin-bottom: 24px;
	letter-spacing: -0.01em;
}

.hero-desc {
	font-size: 1rem;
	color: var(--c-body);
	line-height: 1.8;
	margin-bottom: 32px;
	max-width: 520px;
}

/* ── Social Buttons ── */
.hero-socials {
	display: flex;
	gap: 10px;
	flex-wrap: wrap;
}

.social-btn {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 16px;
	height: 40px;
	background: var(--c-canvas);
	border: 1px solid var(--c-hairline);
	border-radius: 8px;
	color: var(--c-ink);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	transition: background 0.2s, border-color 0.2s;
}

.social-btn:hover {
	background: var(--c-surface-card);
	border-color: var(--c-surface-cream-strong);
}

.social-btn svg {
	color: var(--c-muted);
	flex-shrink: 0;
}

/* ── Profile Card (Dark) ── */
.profile-card {
	background: var(--c-surface-dark);
	border-radius: 16px;
	padding: 32px;
	width: 264px;
	display: flex;
	flex-direction: column;
	gap: 20px;
	flex-shrink: 0;
}

.profile-avatar {
	width: 72px;
	height: 72px;
	border-radius: 50%;
	overflow: hidden;
	background: var(--c-surface-dark-elevated);
}

.profile-avatar img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.profile-identity {
	display: flex;
	flex-direction: column;
	gap: 3px;
}

.profile-name {
	font-size: 1rem;
	font-weight: 600;
	color: var(--c-on-dark);
	letter-spacing: -0.02em;
}

.profile-subtitle {
	font-size: 0.8125rem;
	color: var(--c-on-dark-soft);
}

.profile-divider {
	height: 1px;
	background: rgba(250,249,245,0.08);
}

/* ── Stats Row ── */
.stats-row {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 4px;
}

.stat {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2px;
}

.stat-value {
	font-family: var(--font-display);
	font-size: 1.375rem;
	font-weight: 500;
	color: var(--c-on-dark);
	letter-spacing: -0.03em;
	line-height: 1;
}

.stat-label {
	font-size: 0.625rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 0.5px;
	color: var(--c-on-dark-soft);
	text-align: center;
}

.profile-status {
	display: flex;
	align-items: center;
	gap: 8px;
	font-size: 0.8125rem;
	color: var(--c-on-dark-soft);
}

.status-dot {
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: var(--c-teal);
	flex-shrink: 0;
}

/* ── Skills Section ── */
.skills-section {
	padding: 80px 24px;
	background: var(--c-surface-soft);
}

.skills-inner {
	max-width: 1100px;
	margin: 0 auto;
}

.section-heading {
	font-family: var(--font-display);
	font-size: 2.25rem;
	font-weight: 400;
	letter-spacing: -0.04em;
	color: var(--c-ink);
	margin-bottom: 32px;
}

.skills-grid {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}

.skill-pill {
	display: inline-flex;
	align-items: center;
	padding: 8px 18px;
	background: var(--c-surface-card);
	border-radius: 9999px;
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--c-ink);
	transition: background 0.2s, color 0.2s;
	cursor: default;
}

.skill-pill:hover {
	background: var(--c-surface-cream-strong);
}

/* ── Code Section ── */
.code-section {
	padding: 80px 24px;
}

.code-inner {
	max-width: 680px;
	margin: 0 auto;
}

.code-card {
	background: var(--c-surface-dark);
	border-radius: 12px;
	overflow: hidden;
}

.code-header {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 13px 20px;
	background: var(--c-surface-dark-elevated);
	border-bottom: 1px solid rgba(250,249,245,0.06);
}

.code-dots {
	display: flex;
	gap: 6px;
}

.dot {
	width: 10px;
	height: 10px;
	border-radius: 50%;
}

.dot-red    { background: #c64545; }
.dot-yellow { background: #d4a017; }
.dot-green  { background: #5db872; }

.code-filename {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	color: var(--c-on-dark-soft);
}

.code-body {
	padding: 28px 32px;
	font-family: var(--font-mono);
	font-size: 0.9375rem;
	line-height: 1.8;
	overflow-x: auto;
}

/* Syntax tokens */
.t-kw     { color: #cc785c; }   /* coral — keyword */
.t-var    { color: #faf9f5; }   /* on-dark — identifier */
.t-op     { color: #6c6a64; }   /* muted — operator */
.t-key    { color: #5db8a6; }   /* teal — object key */
.t-str    { color: #a09d96; }   /* on-dark-soft — string */
.t-bool   { color: #e8a55a; }   /* amber — boolean */
.t-punc   { color: #504e49; }   /* muted-soft — punctuation */
.t-bracket{ color: #faf9f5; }   /* on-dark — brackets */

/* ── Contact Section ── */
.contact-section {
	padding: 80px 24px;
	background: var(--c-surface-soft);
}

.contact-inner {
	max-width: 1100px;
	margin: 0 auto;
}

.contact-card {
	background: var(--c-primary);
	border-radius: 12px;
	padding: 56px 64px;
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	gap: 48px;
}

.contact-title {
	font-family: var(--font-display);
	font-size: 2.25rem;
	font-weight: 400;
	letter-spacing: -0.04em;
	color: #fff;
	margin-bottom: 12px;
}

.contact-desc {
	font-size: 1rem;
	color: rgba(255,255,255,.8);
	line-height: 1.7;
	max-width: 340px;
}

.contact-links {
	display: flex;
	flex-direction: column;
	gap: 10px;
	flex-shrink: 0;
	min-width: 296px;
}

.contact-link {
	display: flex;
	align-items: center;
	gap: 14px;
	padding: 14px 18px;
	background: rgba(255,255,255,.12);
	border-radius: 10px;
	color: #fff;
	text-decoration: none;
	transition: background 0.2s;
}

.contact-link:hover {
	background: rgba(255,255,255,.2);
}

.contact-link > svg:first-child {
	flex-shrink: 0;
	opacity: 0.9;
}

.contact-link-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 1px;
}

.contact-link-name {
	font-size: 0.9375rem;
	font-weight: 500;
}

.contact-link-handle {
	font-size: 0.75rem;
	opacity: 0.72;
}

.contact-arrow {
	flex-shrink: 0;
	opacity: 0.7;
	transition: opacity 0.2s, transform 0.2s;
}

.contact-link:hover .contact-arrow {
	opacity: 1;
	transform: translate(2px, -2px);
}

/* ── Responsive ── */
@media (max-width: 1024px) {
	.hero-inner {
		grid-template-columns: 1fr;
		gap: 48px;
	}

	.profile-card {
		width: 100%;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		gap: 24px;
	}

	.profile-divider {
		display: none;
	}

	.stats-row {
		flex: 1;
		min-width: 200px;
	}

	.contact-card {
		flex-direction: column;
		padding: 48px;
	}

	.contact-links {
		min-width: 100%;
	}
}

@media (max-width: 768px) {
	.hero {
		padding: 64px 16px 56px;
	}

	.hero-name {
		font-size: 2.5rem;
	}

	.skills-section,
	.code-section,
	.contact-section {
		padding: 64px 16px;
	}

	.code-body {
		padding: 20px 20px;
		font-size: 0.875rem;
	}

	.contact-card {
		padding: 32px 24px;
	}

	.contact-title {
		font-size: 1.75rem;
	}

	.profile-card {
		flex-direction: column;
	}
}
</style>
