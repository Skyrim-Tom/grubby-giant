---
import Layout from '../layouts/Layout.astro';

const title = "相册";
const description = "我的摄影作品展示";

// CDN 基础路径 - 修改为你的 GitHub 用户名和仓库名
const CDN_BASE = "https://cdn.jsdelivr.net/gh/yourname/blog-images@main/gallery";

const photos = [
	{
		id: 1,
		title: "日落余晖",
		description: "海边日落的美丽瞬间，金色的阳光洒在海面上",
		category: "风景",
		location: "厦门",
		date: "2026-03-10",
		imageUrl: `${CDN_BASE}/sunset-xiamen.jpg`,
		thumbUrl: `${CDN_BASE}/sunset-xiamen-thumb.jpg`
	},
	{
		id: 2,
		title: "城市夜景",
		description: "繁华都市的霓虹灯光，展现现代城市的魅力",
		category: "城市",
		location: "上海",
		date: "2026-03-05",
		imageUrl: `${CDN_BASE}/city-night-shanghai.jpg`,
		thumbUrl: `${CDN_BASE}/city-night-shanghai-thumb.jpg`
	},
	{
		id: 3,
		title: "春日花开",
		description: "樱花盛开的季节，粉色的花瓣随风飘落",
		category: "自然",
		location: "杭州",
		date: "2026-03-01",
		imageUrl: `${CDN_BASE}/spring-flowers-hangzhou.jpg`,
		thumbUrl: `${CDN_BASE}/spring-flowers-hangzhou-thumb.jpg`
	},
	{
		id: 4,
		title: "街头人文",
		description: "老街上的手艺人，专注地制作着传统工艺品",
		category: "人文",
		location: "成都",
		date: "2026-02-28",
		imageUrl: `${CDN_BASE}/street-culture-chengdu.jpg`,
		thumbUrl: `${CDN_BASE}/street-culture-chengdu-thumb.jpg`
	},
	{
		id: 5,
		title: "山间晨雾",
		description: "清晨的山间云雾缭绕，宛如仙境",
		category: "风景",
		location: "黄山",
		date: "2026-02-20",
		imageUrl: `${CDN_BASE}/mountain-mist-huangshan.jpg`,
		thumbUrl: `${CDN_BASE}/mountain-mist-huangshan-thumb.jpg`
	},
	{
		id: 6,
		title: "古镇水乡",
		description: "江南水乡的宁静与古朴，小桥流水人家",
		category: "城市",
		location: "乌镇",
		date: "2026-02-15",
		imageUrl: `${CDN_BASE}/ancient-town-wuzhen.jpg`,
		thumbUrl: `${CDN_BASE}/ancient-town-wuzhen-thumb.jpg`
	}
];

const categories = ["全部", "风景", "城市", "自然", "人文"];
---

<Layout title={title} description={description}>
	<div class="gallery-page">
		<!-- Hero Header -->
		<div class="gallery-hero">
			<div class="hero-container">
				<h1 class="hero-title">摄影作品</h1>
				<p class="hero-desc">用镜头捕捉生活中的美好瞬间</p>
				<div class="gallery-stats">
					<div class="stat-item">
						<span class="stat-value">{photos.length}</span>
						<span class="stat-label">张作品</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-value">{categories.length - 1}</span>
						<span class="stat-label">个分类</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Gallery Content -->
		<div class="gallery-content">
			<!-- Filter Bar -->
			<div class="filter-bar">
				<div class="filter-container">
					<span class="filter-label">
						<svg class="filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 6h16M4 12h16M4 18h7"/>
						</svg>
						筛选
					</span>
					<div class="filter-tabs">
						{categories.map((category) => (
							<button class={`filter-tab ${category === '全部' ? 'active' : ''}`} data-category={category}>
								{category}
							</button>
						))}
					</div>
				</div>
			</div>

			<!-- Photo Grid -->
			<div class="photo-grid">
				{photos.map((photo, index) => (
					<div class="photo-card" data-category={photo.category} style={`animation-delay: ${index * 0.1}s`}>
						<div class="photo-image">
							<img 
								src={photo.thumbUrl || photo.imageUrl} 
								alt={photo.title}
								class="photo-img"
								loading="lazy"
								onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
							/>
							<div class="image-placeholder" style="display: none;">
								<svg class="placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
									<circle cx="8.5" cy="8.5" r="1.5"/>
									<polyline points="21 15 16 10 5 21"/>
								</svg>
							</div>
							<div class="photo-overlay" data-full-image={photo.imageUrl}>
								<div class="overlay-content">
									<span class="photo-category">{photo.category}</span>
									<button class="view-btn">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
											<path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
										</svg>
										查看
									</button>
								</div>
							</div>
						</div>
						<div class="photo-info">
							<h3 class="photo-title">{photo.title}</h3>
							<p class="photo-desc">{photo.description}</p>
							<div class="photo-meta">
								<span class="meta-item">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
										<path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
									</svg>
									{photo.location}
								</span>
								<span class="meta-item">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
										<line x1="16" y1="2" x2="16" y2="6"/>
										<line x1="8" y1="2" x2="8" y2="6"/>
										<line x1="3" y1="10" x2="21" y2="10"/>
									</svg>
									{photo.date}
								</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</Layout>

<script>
	const filterTabs = document.querySelectorAll('.filter-tab');
	const photoCards = document.querySelectorAll('.photo-card');

	filterTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			filterTabs.forEach((t) => t.classList.remove('active'));
			tab.classList.add('active');

			const category = tab.getAttribute('data-category');

			photoCards.forEach((card) => {
				const htmlCard = card as HTMLElement;
				if (category === '全部' || card.getAttribute('data-category') === category) {
					htmlCard.style.display = 'block';
					htmlCard.style.animation = 'fadeInUp 0.5s ease forwards';
				} else {
					htmlCard.style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.gallery-page {
		min-height: calc(100vh - var(--header-height));
	}

	/* Hero */
	.gallery-hero {
		background: linear-gradient(180deg, var(--vp-c-bg-alt) 0%, var(--vp-c-bg) 100%);
		padding: 48px 24px 32px;
		border-bottom: 1px solid var(--vp-c-divider);
	}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		text-align: center;
	}

	.hero-title {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--vp-c-text-1);
		margin-bottom: 8px;
		letter-spacing: -0.02em;
	}

	.hero-desc {
		font-size: 1.125rem;
		color: var(--vp-c-text-2);
		margin-bottom: 24px;
	}

	.gallery-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}

	.stat-item {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.stat-value {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--vp-c-brand-1);
	}

	.stat-label {
		font-size: 0.875rem;
		color: var(--vp-c-text-2);
	}

	.stat-divider {
		width: 1px;
		height: 16px;
		background: var(--vp-c-divider);
	}

	/* Gallery Content */
	.gallery-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 64px;
	}

	/* Filter Bar */
	.filter-bar {
		margin-bottom: 32px;
	}

	.filter-container {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.filter-label {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--vp-c-text-2);
	}

	.filter-icon {
		width: 16px;
		height: 16px;
	}

	.filter-tabs {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.filter-tab {
		padding: 8px 16px;
		border: 1px solid var(--vp-c-divider);
		background: var(--vp-c-bg-elv);
		color: var(--vp-c-text-2);
		border-radius: 6px;
		font-size: 0.875rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-tab:hover {
		border-color: var(--vp-c-brand-1);
		color: var(--vp-c-brand-1);
	}

	.filter-tab.active {
		background: var(--vp-c-brand-1);
		border-color: var(--vp-c-brand-1);
		color: white;
	}

	/* Photo Grid */
	.photo-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.photo-card {
		background: var(--vp-c-bg-elv);
		border: 1px solid var(--vp-c-divider);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.3s ease;
		animation: fadeInUp 0.5s ease forwards;
		opacity: 0;
	}

	.photo-card:hover {
		border-color: var(--vp-c-brand-1);
		box-shadow: var(--vp-shadow-2);
		transform: translateY(-4px);
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.photo-image {
		position: relative;
		aspect-ratio: 4/3;
		overflow: hidden;
		background: var(--vp-c-bg-soft);
	}

	.photo-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.photo-card:hover .photo-img {
		transform: scale(1.05);
	}

	.image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--vp-c-brand-soft) 0%, var(--vp-c-bg-soft) 100%);
	}

	.placeholder-icon {
		width: 48px;
		height: 48px;
		color: var(--vp-c-brand-1);
		opacity: 0.5;
	}

	.photo-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		opacity: 0;
		transition: opacity 0.3s;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.photo-card:hover .photo-overlay {
		opacity: 1;
	}

	.overlay-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.photo-category {
		padding: 4px 12px;
		background: var(--vp-c-brand-1);
		color: white;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 500;
	}

	.view-btn {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px 20px;
		background: white;
		border: none;
		border-radius: 6px;
		color: var(--vp-c-text-1);
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}

	.view-btn:hover {
		background: var(--vp-c-brand-1);
		color: white;
	}

	.view-btn svg {
		width: 16px;
		height: 16px;
	}

	.photo-info {
		padding: 20px;
	}

	.photo-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--vp-c-text-1);
		margin-bottom: 8px;
	}

	.photo-desc {
		font-size: 0.875rem;
		color: var(--vp-c-text-2);
		line-height: 1.6;
		margin-bottom: 16px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.photo-meta {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.meta-item {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 0.8125rem;
		color: var(--vp-c-text-3);
	}

	.meta-item svg {
		width: 14px;
		height: 14px;
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.gallery-hero {
			padding: 32px 16px 24px;
		}

		.hero-title {
			font-size: 1.875rem;
		}

		.gallery-content {
			padding: 24px 16px 48px;
		}

		.filter-container {
			flex-direction: column;
			align-items: flex-start;
		}

		.photo-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
