---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const title = "相册";
const description = "摄影、旅行与生活片段";

const albums = (await getCollection('gallery')).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = ["全部", ...new Set(albums.map((album) => album.data.category))];
const locations = [...new Set(albums.map((album) => album.data.location))];

function formatDate(date: Date) {
	return new Date(date).toISOString().split('T')[0];
}
---

<Layout title={title} description={description}>
	<div class="gallery-page">
		<section class="gallery-hero">
			<div class="hero-container">
				<h1 class="hero-title">相册</h1>
				<p class="hero-desc">把照片整理成一篇篇可阅读的影像记录</p>
				<div class="gallery-stats">
					<div class="stat-item">
						<span class="stat-value">{albums.length}</span>
						<span class="stat-label">组相册</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-value">{categories.length - 1}</span>
						<span class="stat-label">个分类</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-value">{locations.length}</span>
						<span class="stat-label">个地点</span>
					</div>
				</div>
			</div>
		</section>

		<section class="gallery-content">
			<div class="filter-bar" aria-label="相册分类">
				{categories.map((category) => (
					<button class={`filter-tab ${category === '全部' ? 'active' : ''}`} type="button" data-category={category}>
						{category}
					</button>
				))}
			</div>

			<div class="album-grid" id="album-grid">
				{albums.map((album, index) => (
					<article class="album-card" data-category={album.data.category} style={`animation-delay: ${index * 0.06}s`}>
						<a class="album-cover-link" href={`/gallery/${album.id}`} aria-label={`打开相册：${album.data.title}`}>
							<img
								class="album-cover"
								src={album.data.cover}
								alt={album.data.coverAlt || album.data.title}
								loading={index < 3 ? 'eager' : 'lazy'}
								onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
							/>
							<div class="album-placeholder" style="display: none;">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
									<circle cx="8.5" cy="8.5" r="1.5"></circle>
									<polyline points="21 15 16 10 5 21"></polyline>
								</svg>
							</div>
						</a>
						<div class="album-info">
							<div class="album-meta">
								<span class="album-category">{album.data.category}</span>
								<span class="album-dot"></span>
								<span>{album.data.location}</span>
								<span class="album-dot"></span>
								<time>{formatDate(album.data.pubDate)}</time>
							</div>
							<h2 class="album-title">
								<a href={`/gallery/${album.id}`}>{album.data.title}</a>
							</h2>
							<p class="album-desc">{album.data.description}</p>
							<div class="album-footer">
								<div class="album-tags">
									{album.data.tags.slice(0, 3).map((tag) => (
										<span>{tag}</span>
									))}
								</div>
								<a class="album-link" href={`/gallery/${album.id}`}>
									查看相册
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<path d="M5 12h14M12 5l7 7-7 7"></path>
									</svg>
								</a>
							</div>
						</div>
					</article>
				))}
			</div>

			<div class="empty-state" id="empty-state" hidden>
				<p>没有找到这个分类下的相册</p>
				<button class="clear-filter" type="button">查看全部</button>
			</div>
		</section>
	</div>
</Layout>

<script>
	const initGalleryFilters = () => {
		const page = document.querySelector('.gallery-page');
		if (!page) return;

		const previousController = (page as HTMLElement).dataset.galleryFilterController;
		if (previousController) {
			window.dispatchEvent(new CustomEvent(`gallery-filter:dispose:${previousController}`));
		}

		const controller = new AbortController();
		const controllerId = crypto.randomUUID();
		(page as HTMLElement).dataset.galleryFilterController = controllerId;
		window.addEventListener(`gallery-filter:dispose:${controllerId}`, () => controller.abort(), { once: true });

		const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
		const cards = document.querySelectorAll<HTMLElement>('.album-card');
		const emptyState = document.querySelector<HTMLElement>('#empty-state');
		const clearFilter = document.querySelector<HTMLButtonElement>('.clear-filter');

		const applyFilter = (category: string) => {
			let visibleCount = 0;
			tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.category === category));
			cards.forEach((card) => {
				const visible = category === '全部' || card.dataset.category === category;
				card.hidden = !visible;
				if (visible) visibleCount += 1;
			});
			if (emptyState) emptyState.hidden = visibleCount > 0;
		};

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => applyFilter(tab.dataset.category || '全部'), { signal: controller.signal });
		});
		clearFilter?.addEventListener('click', () => applyFilter('全部'), { signal: controller.signal });
	};

	initGalleryFilters();
	if (!(window as Window & { __galleryFilterListener?: boolean }).__galleryFilterListener) {
		document.addEventListener('astro:page-load', initGalleryFilters);
		(window as Window & { __galleryFilterListener?: boolean }).__galleryFilterListener = true;
	}
</script>

<style>
	.gallery-page {
		min-height: calc(100vh - var(--header-height));
	}

	.gallery-hero {
		background: linear-gradient(180deg, var(--vp-c-bg-alt) 0%, var(--vp-c-bg) 100%);
		padding: 48px 24px 32px;
		border-bottom: 1px solid var(--vp-c-divider);
	}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.hero-title {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--vp-c-text-1);
		margin-bottom: 8px;
		letter-spacing: 0;
	}

	.hero-desc {
		font-size: 1.125rem;
		color: var(--vp-c-text-2);
		margin-bottom: 24px;
	}

	.gallery-stats {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.stat-item {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.stat-value {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--vp-c-brand-1);
	}

	.stat-label {
		font-size: 0.875rem;
		color: var(--vp-c-text-2);
	}

	.stat-divider {
		width: 1px;
		height: 16px;
		background: var(--vp-c-divider);
	}

	.gallery-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 64px;
	}

	.filter-bar {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 28px;
	}

	.filter-tab {
		padding: 8px 16px;
		border: 1px solid var(--vp-c-divider);
		background: var(--vp-c-bg-elv);
		color: var(--vp-c-text-2);
		border-radius: 6px;
		font-size: 0.875rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-tab:hover,
	.filter-tab:focus-visible {
		border-color: var(--vp-c-brand-1);
		color: var(--vp-c-brand-1);
		outline: none;
	}

	.filter-tab.active {
		background: var(--vp-c-brand-1);
		border-color: var(--vp-c-brand-1);
		color: white;
	}

	.album-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.album-card {
		background: var(--vp-c-bg-elv);
		border: 1px solid var(--vp-c-divider);
		border-radius: 8px;
		overflow: hidden;
		transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
		animation: fadeInUp 0.45s ease forwards;
		opacity: 0;
	}

	.album-card:hover {
		border-color: var(--vp-c-brand-1);
		box-shadow: var(--vp-shadow-2);
		transform: translateY(-3px);
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.album-cover-link {
		position: relative;
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--vp-c-bg-soft);
	}

	.album-cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.album-card:hover .album-cover {
		transform: scale(1.04);
	}

	.album-placeholder {
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--vp-c-brand-soft) 0%, var(--vp-c-bg-soft) 100%);
	}

	.album-placeholder svg {
		width: 48px;
		height: 48px;
		color: var(--vp-c-brand-1);
		opacity: 0.55;
	}

	.album-info {
		padding: 18px;
	}

	.album-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 10px;
		color: var(--vp-c-text-3);
		font-size: 0.8125rem;
	}

	.album-category {
		color: var(--vp-c-brand-1);
		font-weight: 600;
	}

	.album-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--vp-c-text-3);
	}

	.album-title {
		margin-bottom: 10px;
		font-size: 1.125rem;
		line-height: 1.4;
	}

	.album-title a {
		color: var(--vp-c-text-1);
		text-decoration: none;
	}

	.album-title a:hover {
		color: var(--vp-c-brand-1);
	}

	.album-desc {
		margin-bottom: 16px;
		color: var(--vp-c-text-2);
		font-size: 0.875rem;
		line-height: 1.65;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.album-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.album-tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}

	.album-tags span {
		padding: 3px 8px;
		border-radius: 4px;
		background: var(--vp-c-bg-soft);
		color: var(--vp-c-text-2);
		font-size: 0.75rem;
	}

	.album-link {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--vp-c-brand-1);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.album-link svg {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.album-link:hover svg {
		transform: translateX(3px);
	}

	.empty-state {
		padding: 48px 20px;
		text-align: center;
		color: var(--vp-c-text-2);
	}

	.clear-filter {
		margin-top: 16px;
		padding: 8px 18px;
		border: 1px solid var(--vp-c-divider);
		border-radius: 6px;
		background: var(--vp-c-bg-elv);
		color: var(--vp-c-text-2);
		cursor: pointer;
	}

	.clear-filter:hover {
		border-color: var(--vp-c-brand-1);
		color: var(--vp-c-brand-1);
	}

	@media (max-width: 1024px) {
		.album-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.gallery-hero {
			padding: 32px 16px 24px;
		}

		.hero-title {
			font-size: 1.875rem;
		}

		.gallery-content {
			padding: 24px 16px 48px;
		}

		.album-grid {
			grid-template-columns: 1fr;
		}

		.album-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
