---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MarkdownImageZoom from '../../components/MarkdownImageZoom.astro';

export async function getStaticPaths() {
	const albums = await getCollection('gallery');
	return albums.map((album) => ({
		params: { slug: album.id },
		props: { album },
	}));
}

const { album } = Astro.props;
const { Content } = await render(album);

function formatDate(date: Date) {
	return new Date(date).toISOString().split('T')[0];
}
---

<Layout title={album.data.title} description={album.data.description}>
	<div class="gallery-detail-page">
		<section class="album-hero">
			<img
				class="album-hero-image"
				src={album.data.cover}
				alt={album.data.coverAlt || album.data.title}
				data-no-zoom
			/>
			<div class="album-hero-overlay"></div>
			<div class="album-hero-content">
				<div class="album-meta">
					<span>{album.data.category}</span>
					<span class="meta-divider"></span>
					<span>{album.data.location}</span>
					<span class="meta-divider"></span>
					<time>{formatDate(album.data.pubDate)}</time>
				</div>
				<h1>{album.data.title}</h1>
				<p>{album.data.description}</p>
			</div>
		</section>

		<div class="album-layout">
			<article class="album-article">
				<div class="article-body">
					<Content />
				</div>
			</article>

			<footer class="album-footer">
				<a class="back-link" href="/gallery">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M19 12H5M12 19l-7-7 7-7"></path>
					</svg>
					返回相册
				</a>
			</footer>
		</div>
	</div>
	<MarkdownImageZoom />
</Layout>

<style>
	.gallery-detail-page {
		min-height: calc(100vh - var(--header-height));
	}

	.album-hero {
		position: relative;
		min-height: min(62vh, 620px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: #0f1115;
	}

	.album-hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.album-hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.74) 100%);
	}

	.album-hero-content {
		position: relative;
		z-index: 1;
		width: min(920px, calc(100% - 48px));
		margin: 0 auto;
		padding: 96px 0 56px;
		color: white;
	}

	.album-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 14px;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.875rem;
		font-weight: 500;
	}

	.meta-divider {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.5);
	}

	.album-hero h1 {
		max-width: 760px;
		margin-bottom: 14px;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.album-hero p {
		max-width: 680px;
		color: rgba(255, 255, 255, 0.82);
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	.album-layout {
		max-width: 920px;
		margin: 0 auto;
		padding: 40px 24px 72px;
	}

	.album-article {
		background: var(--vp-c-bg-elv);
		border: 1px solid var(--vp-c-divider);
		border-radius: 8px;
		padding: 40px;
	}

	.article-body :global(h2) {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--vp-c-text-1);
		margin: 40px 0 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--vp-c-divider);
	}

	.article-body :global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--vp-c-text-1);
		margin: 32px 0 12px;
	}

	.article-body :global(p) {
		font-size: 1rem;
		line-height: 1.85;
		color: var(--vp-c-text-2);
		margin-bottom: 22px;
	}

	.article-body :global(img) {
		display: block;
		width: 100%;
		max-height: 760px;
		object-fit: contain;
		border-radius: 8px;
		margin: 28px 0;
		background: var(--vp-c-bg-soft);
	}

	.article-body :global(a) {
		color: var(--vp-c-brand-1);
		text-decoration: none;
		font-weight: 500;
	}

	.article-body :global(a:hover) {
		text-decoration: underline;
	}

	.album-footer {
		margin-top: 32px;
		padding-top: 28px;
		border-top: 1px solid var(--vp-c-divider);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--vp-c-brand-1);
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.back-link svg {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.back-link:hover svg {
		transform: translateX(-3px);
	}

	@media (max-width: 768px) {
		.album-hero {
			min-height: 520px;
		}

		.album-hero-content {
			width: calc(100% - 32px);
			padding-bottom: 40px;
		}

		.album-layout {
			padding: 24px 16px 56px;
		}

		.album-article {
			padding: 24px;
		}

		.article-body :global(img) {
			margin: 22px 0;
		}
	}
</style>
