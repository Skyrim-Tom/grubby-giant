---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.vue';

const title = "首页";
const description = "欢迎来到 Momoc 的博客，分享前端技术、摄影与生活";

const allPosts = await getCollection('posts');
const latestPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);

const allAlbums = await getCollection('gallery');
const featuredAlbumIds = ['mount-siguniang'];
const latestAlbums = allAlbums
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 4)
	.sort((a, b) => {
		const aIndex = featuredAlbumIds.indexOf(a.id);
		const bIndex = featuredAlbumIds.indexOf(b.id);
		if (aIndex === -1 && bIndex === -1) return 0;
		if (aIndex === -1) return 1;
		if (bIndex === -1) return -1;
		return aIndex - bIndex;
	});

const homeGalleryCovers: Record<string, string> = {
	'rainbow-after-rain': '/images/gallery-home/rainbow-after-rain.jpg',
	'mount-siguniang': '/images/gallery-home/mount-siguniang.jpg',
	'citywalk-in-macau': '/images/gallery-home/citywalk-in-macau.jpg',
	'qi-ao-island-sunset': '/images/gallery-home/qi-ao-island-sunset.jpg',
};

const getHomeGalleryCover = (album: typeof latestAlbums[number]) =>
	homeGalleryCovers[album.id] ?? album.data.cover;
---

<Layout title={title} description={description}>
	<div class="home">

		<!-- ══════════════════════════════════
		     HERO — 奶油画布 + 分栏布局
		     ══════════════════════════════════ -->
		<section class="hero">
			<div class="hero-inner">

				<!-- 左：文字区 -->
				<div class="hero-text">
					<div class="hero-eyebrow">
						<span class="eyebrow-mark" aria-hidden="true">✦</span>
						<span>记录技术与生活</span>
					</div>
					<h1 class="hero-title">
						陶然无喜<br />亦无忧，<br />
						<em class="hero-title-accent">人生且自由。</em>
					</h1>
					<p class="hero-desc">
						练习时长 7 年半的前端开发者，热爱摄影。
						在这里分享开发经验、摄影作品与生活感悟。
					</p>
					<div class="hero-actions">
						<a href="/posts" class="btn-primary">
							浏览文章
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="/gallery" class="btn-secondary">查看相册</a>
					</div>
				</div>

				<!-- 右：站点状态卡片 -->
				<aside class="hero-card" aria-label="站点状态">
					<div class="hero-card-header">
						<div class="hero-card-dots" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</div>
						<span class="hero-card-path">momoc.blog / home</span>
					</div>
					<div class="hero-card-body">
						<div class="hero-card-eyebrow">CURRENTLY</div>
						<p class="hero-card-title">总有一些美好的事情值得记录。</p>
						<div class="hero-card-lines">
							<div class="hero-card-line">
								<span class="hero-card-label">articles</span>
								<span class="hero-card-value">{allPosts.length} 篇</span>
							</div>
							<div class="hero-card-line">
								<span class="hero-card-label">albums</span>
								<span class="hero-card-value">{allAlbums.length} 组</span>
							</div>
							<div class="hero-card-line">
								<span class="hero-card-label">focus</span>
								<span class="hero-card-value hero-card-value-ok">持续探索</span>
							</div>
						</div>
					</div>
					<a href="/posts" class="hero-card-strip">
						<span>
							<strong>最新文章</strong>
							<small>{latestPosts[0]?.data.title}</small>
						</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
							<path d="M7 7h10v10M7 17L17 7"/>
						</svg>
					</a>
				</aside>

			</div>
		</section>

		<!-- ══════════════════════════════════
		     最新文章 — 奶油白背景
		     ══════════════════════════════════ -->
		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<div class="section-label">
						<span class="label-rule" aria-hidden="true"></span>
						<h2 class="label-text">最新文章</h2>
					</div>
					<a href="/posts" class="view-all">
						查看全部
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
				<div class="posts-grid">
					{latestPosts.map((post) => (
						<PostCard post={post} client:visible />
					))}
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════
		     摄影作品 — 柔奶油背景
		     ══════════════════════════════════ -->
		<section class="section section-soft">
			<div class="section-inner">
				<div class="section-head">
					<div class="section-label">
						<span class="label-rule" aria-hidden="true"></span>
						<h2 class="label-text">摄影作品</h2>
					</div>
					<a href="/gallery" class="view-all">
						查看全部
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
				<div class="gallery-showcase">
					{latestAlbums.map((album, index) => (
						<a
							class={`gallery-item ${index === 0 ? 'gallery-item-featured' : ''}`}
							href={`/gallery/${album.id}`}
							aria-label={`查看相册：${album.data.title}`}
						>
							<div class="gallery-img-wrap">
								<img
									src={getHomeGalleryCover(album)}
									alt={album.data.coverAlt || album.data.title}
									loading="lazy"
									decoding="async"
									width="1200"
									height="900"
									onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
								/>
								<div class="gallery-placeholder" style="display:none;" aria-hidden="true">
									<span>◆</span>
								</div>
								<div class="gallery-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
								<div class="gallery-overlay">
									<div class="gallery-meta-row">
										<span class="gallery-badge">{album.data.category}</span>
										<span class="gallery-location">{album.data.location}</span>
									</div>
									<div class="gallery-title-row">
										<h3 class="gallery-title">{album.data.title}</h3>
										<span class="gallery-arrow" aria-hidden="true">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
												<path d="M7 7h10v10M7 17L17 7"/>
											</svg>
										</span>
									</div>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════
		     关于我 CTA — 珊瑚色全幅卡片
		     ══════════════════════════════════ -->
		<section class="section">
			<div class="section-inner">
				<div class="cta-coral">
					<div class="cta-coral-body">
						<h2 class="cta-coral-title">关于我</h2>
						<p class="cta-coral-desc">
							热爱技术的开发者，喜欢用代码创造美好的事物。
							同时热爱摄影，用镜头记录生活中的精彩瞬间。
						</p>
					</div>
					<a href="/about" class="cta-coral-btn">
						了解更多
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

	</div>
</Layout>

<style>
/* ── Hero ── */
.hero {
	padding: 96px 24px 88px;
}

.hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 64px;
	align-items: center;
}

.hero-eyebrow {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	font-size: 0.6875rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	color: var(--c-muted);
	margin-bottom: 28px;
}

.eyebrow-mark {
	color: var(--c-primary);
}

.hero-title {
	font-family: var(--font-display);
	font-size: clamp(2.5rem, 4.5vw, 4rem);
	font-weight: 400;
	line-height: 1.08;
	letter-spacing: -0.04em;
	color: var(--c-ink);
	margin-bottom: 24px;
}

.hero-title em {
	font-style: italic;
	color: var(--c-primary);
}

.hero-title-accent {
	position: relative;
	display: inline-block;
	font-style: normal;
	letter-spacing: 0;
}

.hero-title-accent::after {
	content: "";
	position: absolute;
	left: 0.04em;
	right: 0.02em;
	bottom: 0.04em;
	height: 0.16em;
	background: color-mix(in srgb, var(--c-primary) 24%, transparent);
	border-radius: 999px;
	z-index: -1;
	transform-origin: left center;
	animation: accent-rule-in 0.8s ease-out 0.35s both;
}

@keyframes accent-rule-in {
	from {
		opacity: 0;
		transform: scaleX(0.18);
	}

	to {
		opacity: 1;
		transform: scaleX(1);
	}
}

@media (prefers-reduced-motion: reduce) {
	.hero-title-accent::after {
		animation: none;
	}
}

.hero-desc {
	font-size: 1rem;
	color: var(--c-body);
	line-height: 1.75;
	margin-bottom: 36px;
	max-width: 420px;
}

.hero-actions {
	display: flex;
	gap: 12px;
	flex-wrap: wrap;
}

.btn-primary {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: var(--c-primary);
	color: #fff;
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	transition: background 0.2s;
}

.btn-primary:hover {
	background: var(--c-primary-active);
}

.btn-secondary {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: transparent;
	color: var(--c-ink);
	border: 1px solid var(--c-hairline);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	transition: background 0.2s, border-color 0.2s;
}

.btn-secondary:hover {
	background: var(--c-surface-card);
	border-color: var(--c-surface-cream-strong);
}

/* ── Hero Card (Status Panel) ── */
.hero-card {
	background: var(--c-surface-dark);
	border-radius: 16px;
	overflow: hidden;
	color: var(--c-on-dark);
	box-shadow: 0 24px 70px rgba(20, 20, 19, 0.14);
}

.hero-card-header {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 14px 18px;
	background: var(--c-surface-dark-elevated);
	border-bottom: 1px solid rgba(250, 249, 245, 0.06);
}

.hero-card-dots {
	display: flex;
	gap: 6px;
	flex-shrink: 0;
}

.hero-card-dots span {
	width: 9px;
	height: 9px;
	border-radius: 50%;
	background: var(--c-muted-soft);
}

.hero-card-dots span:nth-child(1) {
	background: var(--c-error);
}

.hero-card-dots span:nth-child(2) {
	background: var(--c-amber);
}

.hero-card-dots span:nth-child(3) {
	background: var(--c-teal);
}

.hero-card-path {
	font-family: var(--font-mono);
	font-size: 0.75rem;
	color: var(--c-on-dark-soft);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hero-card-body {
	padding: 32px 32px 28px;
}

.hero-card-eyebrow {
	font-size: 0.625rem;
	font-weight: 500;
	letter-spacing: 1.8px;
	text-transform: uppercase;
	color: var(--c-primary);
	margin-bottom: 18px;
}

.hero-card-title {
	font-family: var(--font-display);
	font-size: 1.625rem;
	font-weight: 400;
	line-height: 1.35;
	letter-spacing: 0;
	color: var(--c-on-dark);
	margin-bottom: 28px;
}

.hero-card-lines {
	display: grid;
	gap: 13px;
}

.hero-card-line {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 18px;
	font-family: var(--font-mono);
	font-size: 0.8125rem;
}

.hero-card-label {
	color: var(--c-muted);
}

.hero-card-value {
	color: var(--c-on-dark);
	text-align: right;
}

.hero-card-value-ok {
	color: var(--c-teal);
}

.hero-card-strip {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 18px;
	padding: 18px 22px;
	background: rgba(250, 249, 245, 0.05);
	border-top: 1px solid rgba(250, 249, 245, 0.06);
	color: var(--c-on-dark);
	text-decoration: none;
	transition: background 0.2s;
}

.hero-card-strip:hover {
	background: rgba(250, 249, 245, 0.09);
}

.hero-card-strip span {
	display: grid;
	gap: 4px;
	min-width: 0;
}

.hero-card-strip strong {
	font-size: 0.8125rem;
	font-weight: 500;
	color: var(--c-primary);
}

.hero-card-strip small {
	font-size: 0.8125rem;
	line-height: 1.5;
	color: var(--c-on-dark-soft);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hero-card-strip svg {
	flex-shrink: 0;
	color: var(--c-on-dark-soft);
	transition: transform 0.2s, color 0.2s;
}

.hero-card-strip:hover svg {
	color: var(--c-primary);
	transform: translate(2px, -2px);
}

/* ── Sections ── */
.section {
	padding: 80px 24px;
}

.section-soft {
	background: var(--c-surface-soft);
}

.section-inner {
	max-width: 1100px;
	margin: 0 auto;
}

.section-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 40px;
}

.section-label {
	display: flex;
	align-items: center;
	gap: 14px;
}

.label-rule {
	display: block;
	width: 24px;
	height: 2px;
	background: var(--c-primary);
	flex-shrink: 0;
}

.label-text {
	font-family: var(--font-display);
	font-size: 1.625rem;
	font-weight: 500;
	letter-spacing: -0.025em;
	color: var(--c-ink);
}

.view-all {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	color: var(--c-primary);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	transition: gap 0.2s;
}

.view-all:hover {
	gap: 10px;
}

/* ── Posts Grid ── */
.posts-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
	gap: 20px;
}

/* ── Gallery Showcase ── */
.gallery-showcase {
	display: grid;
	grid-template-columns: minmax(0, 1.28fr) minmax(320px, 0.72fr);
	grid-template-rows: repeat(3, 164px);
	gap: 14px;
	content-visibility: auto;
	contain-intrinsic-size: 680px;
}

.gallery-item {
	display: block;
	min-width: 0;
	text-decoration: none;
	contain: layout paint style;
}

.gallery-item-featured {
	grid-row: span 3;
}

.gallery-img-wrap {
	position: relative;
	width: 100%;
	height: 100%;
	min-height: 0;
	border-radius: 8px;
	overflow: hidden;
	background: var(--c-surface-card);
	isolation: isolate;
	box-shadow: 0 1px 0 rgba(20, 20, 19, 0.05);
	transform: translateZ(0);
}

.gallery-img-wrap img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	backface-visibility: hidden;
	transform: scale(1.001);
	transition: transform 0.6s ease;
	will-change: transform;
}

.gallery-item:hover .gallery-img-wrap img {
	transform: scale(1.025);
}

.gallery-placeholder {
	position: absolute;
	inset: 0;
	background: var(--c-surface-card);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--c-primary);
	font-size: 2rem;
	opacity: 0.4;
}

.gallery-number {
	position: absolute;
	top: 16px;
	left: 16px;
	z-index: 2;
	font-family: var(--font-display);
	font-size: 1rem;
	line-height: 1;
	color: rgba(255, 255, 255, 0.72);
	text-shadow: 0 1px 14px rgba(0, 0, 0, 0.28);
}

.gallery-overlay {
	position: absolute;
	inset: 0;
	z-index: 1;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	gap: 12px;
	padding: 22px;
	background:
		linear-gradient(to top, rgba(20, 20, 19, 0.76) 0%, rgba(20, 20, 19, 0.22) 48%, rgba(20, 20, 19, 0.02) 100%);
	color: #fff;
}

.gallery-meta-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
}

.gallery-badge {
	font-size: 0.625rem;
	font-weight: 600;
	letter-spacing: 1.4px;
	text-transform: uppercase;
	color: rgba(255, 255, 255, 0.9);
}

.gallery-location {
	font-size: 0.75rem;
	color: rgba(255, 255, 255, 0.72);
	white-space: nowrap;
}

.gallery-title-row {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 18px;
}

.gallery-title {
	font-family: var(--font-display);
	font-size: 1.5rem;
	font-weight: 500;
	line-height: 1.12;
	letter-spacing: 0;
	color: #fff;
}

.gallery-item:not(.gallery-item-featured) .gallery-title {
	font-size: 1.125rem;
}

.gallery-arrow {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 32px;
	height: 32px;
	border: 1px solid rgba(255, 255, 255, 0.28);
	border-radius: 50%;
	color: rgba(255, 255, 255, 0.86);
	flex-shrink: 0;
	transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
}

.gallery-item:hover .gallery-arrow {
	background: #fff;
	border-color: #fff;
	color: #181715;
	transform: translate(2px, -2px);
}

.gallery-item:hover .gallery-arrow svg {
	stroke: #181715;
}

/* ── CTA Coral ── */
.cta-coral {
	background: var(--c-primary);
	border-radius: 12px;
	padding: 52px 64px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 32px;
}

.cta-coral-title {
	font-family: var(--font-display);
	font-size: 2.25rem;
	font-weight: 400;
	letter-spacing: -0.04em;
	color: #fff;
	margin-bottom: 12px;
}

.cta-coral-desc {
	font-size: 1rem;
	color: rgba(255,255,255,.8);
	line-height: 1.7;
	max-width: 480px;
}

.cta-coral-btn {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: var(--c-canvas);
	color: var(--c-ink);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	white-space: nowrap;
	flex-shrink: 0;
	transition: background 0.2s;
}

.cta-coral-btn:hover {
	background: var(--c-surface-card);
}

/* ── Responsive ── */
@media (max-width: 1024px) {
	.hero-inner {
		grid-template-columns: 1fr;
		gap: 48px;
	}

	.hero-card {
		display: none;
	}

	.gallery-showcase {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: none;
	}

	.gallery-item,
	.gallery-item-featured {
		grid-row: auto;
		aspect-ratio: 4 / 3;
	}
}

@media (max-width: 768px) {
	.hero {
		padding: 64px 16px 56px;
	}

	.section {
		padding: 64px 16px;
	}

	.posts-grid {
		grid-template-columns: 1fr;
	}

	.gallery-showcase {
		grid-template-columns: 1fr;
		gap: 12px;
		contain-intrinsic-size: 920px;
	}

	.gallery-item,
	.gallery-item-featured {
		aspect-ratio: 4 / 3;
	}

	.gallery-overlay {
		padding: 18px;
	}

	.gallery-title {
		font-size: 1.25rem;
	}

