---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.vue';

const title = "首页";
const description = "欢迎来到 Momoc 的博客，分享前端技术、摄影与生活";

const allPosts = await getCollection('posts');
const latestPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);

const allAlbums = await getCollection('gallery');
const latestAlbums = allAlbums
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 4);
---

<Layout title={title} description={description}>
	<div class="home">

		<!-- ══════════════════════════════════
		     HERO — 奶油画布 + 分栏布局
		     ══════════════════════════════════ -->
		<section class="hero">
			<div class="hero-inner">

				<!-- 左：文字区 -->
				<div class="hero-text">
					<div class="hero-eyebrow">
						<span class="eyebrow-mark" aria-hidden="true">✦</span>
						<span>记录技术与生活</span>
					</div>
					<h1 class="hero-title">
						陶然无喜<br />亦无忧，<br />
						<em>人生且自由。</em>
					</h1>
					<p class="hero-desc">
						练习时长 7 年半的前端开发者，热爱摄影。
						在这里分享开发经验、摄影作品与生活感悟。
					</p>
					<div class="hero-actions">
						<a href="/posts" class="btn-primary">
							浏览文章
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="/gallery" class="btn-secondary">查看相册</a>
					</div>
				</div>

				<!-- 右：深色卡片 -->
				<div class="hero-card" aria-hidden="true">
					<div class="hero-card-eyebrow">LATEST NOTE</div>
					<blockquote class="hero-card-quote">
						"The best interface<br />is no interface."
					</blockquote>
					<div class="hero-card-footer">
						<span class="hero-card-dot"></span>
						<span>Front-end · Photography · Life</span>
					</div>
				</div>

			</div>
		</section>

		<!-- ══════════════════════════════════
		     最新文章 — 奶油白背景
		     ══════════════════════════════════ -->
		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<div class="section-label">
						<span class="label-rule" aria-hidden="true"></span>
						<h2 class="label-text">最新文章</h2>
					</div>
					<a href="/posts" class="view-all">
						查看全部
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
				<div class="posts-grid">
					{latestPosts.map((post) => (
						<PostCard post={post} client:visible />
					))}
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════
		     摄影作品 — 柔奶油背景
		     ══════════════════════════════════ -->
		<section class="section section-soft">
			<div class="section-inner">
				<div class="section-head">
					<div class="section-label">
						<span class="label-rule" aria-hidden="true"></span>
						<h2 class="label-text">摄影作品</h2>
					</div>
					<a href="/gallery" class="view-all">
						查看全部
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
				<div class="gallery-grid">
					{latestAlbums.map((album, index) => (
						<a
							class={`gallery-item ${index === 0 ? 'gallery-item-large' : ''}`}
							href={`/gallery/${album.id}`}
						>
							<div class="gallery-img-wrap">
								<img
									src={album.data.cover}
									alt={album.data.coverAlt || album.data.title}
									loading="lazy"
									onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
								/>
								<div class="gallery-placeholder" style="display:none;" aria-hidden="true">
									<span>◆</span>
								</div>
								<div class="gallery-overlay">
									<span class="gallery-badge">{album.data.category}</span>
									<span class="gallery-location">{album.data.location}</span>
								</div>
							</div>
							<p class="gallery-caption">{album.data.title}</p>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════
		     关于我 CTA — 珊瑚色全幅卡片
		     ══════════════════════════════════ -->
		<section class="section">
			<div class="section-inner">
				<div class="cta-coral">
					<div class="cta-coral-body">
						<h2 class="cta-coral-title">关于我</h2>
						<p class="cta-coral-desc">
							热爱技术的开发者，喜欢用代码创造美好的事物。
							同时热爱摄影，用镜头记录生活中的精彩瞬间。
						</p>
					</div>
					<a href="/about" class="cta-coral-btn">
						了解更多
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

	</div>
</Layout>

<style>
/* ── Hero ── */
.hero {
	padding: 96px 24px 88px;
}

.hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 64px;
	align-items: center;
}

.hero-eyebrow {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	font-size: 0.6875rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	color: var(--c-muted);
	margin-bottom: 28px;
}

.eyebrow-mark {
	color: var(--c-primary);
}

.hero-title {
	font-family: var(--font-display);
	font-size: clamp(2.5rem, 4.5vw, 4rem);
	font-weight: 400;
	line-height: 1.08;
	letter-spacing: -0.04em;
	color: var(--c-ink);
	margin-bottom: 24px;
}

.hero-title em {
	font-style: italic;
	color: var(--c-primary);
}

.hero-desc {
	font-size: 1rem;
	color: var(--c-body);
	line-height: 1.75;
	margin-bottom: 36px;
	max-width: 420px;
}

.hero-actions {
	display: flex;
	gap: 12px;
	flex-wrap: wrap;
}

.btn-primary {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: var(--c-primary);
	color: #fff;
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	transition: background 0.2s;
}

.btn-primary:hover {
	background: var(--c-primary-active);
}

.btn-secondary {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: transparent;
	color: var(--c-ink);
	border: 1px solid var(--c-hairline);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	transition: background 0.2s, border-color 0.2s;
}

.btn-secondary:hover {
	background: var(--c-surface-card);
	border-color: var(--c-surface-cream-strong);
}

/* ── Hero Card (Dark) ── */
.hero-card {
	background: var(--c-surface-dark);
	border-radius: 16px;
	padding: 40px;
	color: var(--c-on-dark);
}

.hero-card-eyebrow {
	font-size: 0.625rem;
	font-weight: 500;
	letter-spacing: 1.8px;
	text-transform: uppercase;
	color: var(--c-primary);
	margin-bottom: 24px;
}

.hero-card-quote {
	font-family: var(--font-display);
	font-size: 1.5rem;
	font-weight: 400;
	font-style: italic;
	line-height: 1.35;
	letter-spacing: -0.02em;
	color: var(--c-on-dark);
	margin-bottom: 32px;
}

.hero-card-footer {
	display: flex;
	align-items: center;
	gap: 10px;
	font-size: 0.8125rem;
	color: var(--c-on-dark-soft);
}

.hero-card-dot {
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: var(--c-teal);
	flex-shrink: 0;
}

/* ── Sections ── */
.section {
	padding: 80px 24px;
}

.section-soft {
	background: var(--c-surface-soft);
}

.section-inner {
	max-width: 1100px;
	margin: 0 auto;
}

.section-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 40px;
}

.section-label {
	display: flex;
	align-items: center;
	gap: 14px;
}

.label-rule {
	display: block;
	width: 24px;
	height: 2px;
	background: var(--c-primary);
	flex-shrink: 0;
}

.label-text {
	font-family: var(--font-display);
	font-size: 1.625rem;
	font-weight: 500;
	letter-spacing: -0.025em;
	color: var(--c-ink);
}

.view-all {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	color: var(--c-primary);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	transition: gap 0.2s;
}

.view-all:hover {
	gap: 10px;
}

/* ── Posts Grid ── */
.posts-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
	gap: 20px;
}

/* ── Gallery ── */
.gallery-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 16px;
}

.gallery-item {
	text-decoration: none;
	display: block;
}

.gallery-item-large {
	grid-column: span 2;
	grid-row: span 2;
}

.gallery-img-wrap {
	position: relative;
	aspect-ratio: 1 / 1;
	border-radius: 12px;
	overflow: hidden;
	background: var(--c-surface-card);
}

.gallery-item-large .gallery-img-wrap {
	aspect-ratio: auto;
	height: calc(100% - 38px);
	min-height: 180px;
}

.gallery-img-wrap img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

.gallery-item:hover .gallery-img-wrap img {
	transform: scale(1.05);
}

.gallery-placeholder {
	position: absolute;
	inset: 0;
	background: var(--c-surface-card);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--c-primary);
	font-size: 2rem;
	opacity: 0.4;
}

.gallery-overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(to top, rgba(20,20,19,.72) 0%, transparent 55%);
	opacity: 0;
	transition: opacity 0.25s;
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	padding: 12px 14px;
}

.gallery-item:hover .gallery-overlay {
	opacity: 1;
}

.gallery-badge {
	font-size: 0.625rem;
	font-weight: 500;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #fff;
	background: var(--c-primary);
	padding: 3px 8px;
	border-radius: 4px;
}

.gallery-location {
	font-size: 0.75rem;
	color: rgba(255,255,255,.85);
}

.gallery-caption {
	margin-top: 9px;
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--c-ink);
	transition: color 0.2s;
}

.gallery-item:hover .gallery-caption {
	color: var(--c-primary);
}

/* ── CTA Coral ── */
.cta-coral {
	background: var(--c-primary);
	border-radius: 12px;
	padding: 52px 64px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 32px;
}

.cta-coral-title {
	font-family: var(--font-display);
	font-size: 2.25rem;
	font-weight: 400;
	letter-spacing: -0.04em;
	color: #fff;
	margin-bottom: 12px;
}

.cta-coral-desc {
	font-size: 1rem;
	color: rgba(255,255,255,.8);
	line-height: 1.7;
	max-width: 480px;
}

.cta-coral-btn {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 0 20px;
	height: 40px;
	background: var(--c-canvas);
	color: var(--c-ink);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 8px;
	white-space: nowrap;
	flex-shrink: 0;
	transition: background 0.2s;
}

.cta-coral-btn:hover {
	background: var(--c-surface-card);
}

/* ── Responsive ── */
@media (max-width: 1024px) {
	.hero-inner {
		grid-template-columns: 1fr;
		gap: 48px;
	}

	.hero-card {
		display: none;
	}

	.gallery-grid {
		grid-template-columns: repeat(2, 1fr);
	}

	.gallery-item-large {
		grid-column: span 1;
		grid-row: span 1;
	}
}

@media (max-width: 768px) {
	.hero {
		padding: 64px 16px 56px;
	}

	.section {
		padding: 64px 16px;
	}

	.posts-grid {
		grid-template-columns: 1fr;
	}

	.gallery-grid {
		grid-template-columns: repeat(2, 1fr);
		gap: 10px;
	}

	.section-head {
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.cta-coral {
		padding: 36px 28px;
		flex-direction: column;
		text-align: center;
	}

	.cta-coral-desc {
		max-width: 100%;
	}
}
</style>
