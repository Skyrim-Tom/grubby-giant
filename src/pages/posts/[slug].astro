---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleList from '../../components/ArticleList.vue';
import TableOfContents from '../../components/TableOfContents.vue';
import MarkdownImageZoom from '../../components/MarkdownImageZoom.astro';

// 生成所有文章路径
export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

// 获取文章数据
const { post } = Astro.props;
const { Content, headings } = await render(post);

// 获取所有文章用于侧边栏
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => 
	new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// 格式化日期
function formatDate(date: Date) {
	return new Date(date).toISOString().split('T')[0];
}

// 提取目录（h2 和 h3）
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={post.data.title} description={post.data.description}>
	<div class="post-page">
		<!-- Article Header -->
		<div class="article-hero" transition:name="article-hero">
			<div class="hero-container">
				<div class="article-meta">
					<span class="meta-category">{post.data.category}</span>
					<span class="meta-divider"></span>
					<time class="meta-date">{formatDate(post.data.pubDate)}</time>
					<span class="meta-divider"></span>
					<span class="meta-readtime">{post.data.readTime}阅读</span>
				</div>
				<h1 class="article-title">{post.data.title}</h1>
				<div class="article-tags">
					{post.data.tags.map((tag: string) => (
						<span class="article-tag">{tag}</span>
					))}
				</div>
			</div>
		</div>

		<!-- Article Layout with Sidebar -->
		<div class="article-layout" transition:animate="none">
			<!-- Left Sidebar: Article List -->
			<aside class="sidebar-left" transition:persist="post-navigation">
				<ArticleList posts={sortedPosts} client:load />
			</aside>

			<!-- Main Content -->
			<main class="article-main" transition:name="article-main">
				<article class="article-content">
					<div class="article-body" id="article-content">
						<Content />
					</div>
				</article>

				<!-- Article Footer -->
				<footer class="article-footer">
					<a href="/posts" class="back-link">
						<svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M19 12H5M12 19l-7-7 7-7"/>
						</svg>
						返回文章列表
					</a>
				</footer>
			</main>

			<!-- Right Sidebar: Table of Contents -->
			<aside class="sidebar-right" transition:name="article-toc">
				<TableOfContents headings={toc} client:load />
			</aside>
		</div>
	</div>
	<MarkdownImageZoom />
</Layout>

<style>
	.post-page {
		min-height: calc(100vh - var(--header-height));
	}

	/* Article Hero */
	.article-hero {
		padding: 56px 24px 40px;
		border-bottom: 1px solid var(--c-hairline-soft);
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 16px;
		font-size: 0.875rem;
	}

	.meta-category {
		color: var(--c-primary);
		font-weight: 500;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.meta-divider {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--c-muted);
	}

	.meta-date,
	.meta-readtime {
		color: var(--c-muted);
	}

	.article-title {
		font-family: var(--font-display);
		font-size: clamp(1.875rem, 4vw, 2.75rem);
		font-weight: 400;
		color: var(--c-ink);
		line-height: 1.15;
		margin-bottom: 20px;
		letter-spacing: -0.04em;
	}

	.article-tags {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
	}

	.article-tag {
		padding: 3px 10px;
		background: var(--c-surface-card);
		border-radius: 9999px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--c-muted);
	}

	/* Article Container */
	.article-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 48px 24px 64px;
	}

	.article-content {
		padding: 0;
	}

	/* Article Body - Typography */
	.article-body :global(h2) {
		font-family: var(--font-display);
		font-size: 1.625rem;
		font-weight: 500;
		color: var(--c-ink);
		margin: 48px 0 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--c-hairline-soft);
		letter-spacing: -0.025em;
	}

	.article-body :global(h3) {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--c-ink);
		margin: 36px 0 12px;
		letter-spacing: -0.02em;
	}

	.article-body :global(p) {
		font-size: 1rem;
		line-height: 1.85;
		color: var(--c-body);
		margin-bottom: 20px;
	}

	.article-body :global(strong) {
		color: var(--c-ink);
		font-weight: 600;
	}

	/* Code Blocks */
	.article-body :global(pre) {
		border-radius: 10px;
		padding: 20px;
		overflow-x: auto;
		margin: 24px 0;
		border: 1px solid var(--c-hairline-soft);
	}

	.article-body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	.article-body :global(pre code) {
		background: none;
		padding: 0;
	}

	.article-body :global(:not(pre) > code) {
		background: var(--c-surface-card);
		color: var(--c-primary);
		padding: 2px 7px;
		border-radius: 4px;
		font-size: 0.875em;
		font-family: var(--font-mono);
	}

	.article-body :global(img) {
		display: block;
		width: 100%;
		max-height: 760px;
		object-fit: contain;
		border-radius: 10px;
		margin: 28px 0;
		background: var(--c-surface-card);
	}

	/* Shiki 双主题代码高亮已在 Layout.astro 全局样式中统一处理 */

	/* Lists */
	.article-body :global(ul),
	.article-body :global(ol) {
		margin: 20px 0;
		padding-left: 24px;
	}

	.article-body :global(li) {
		font-size: 1rem;
		line-height: 1.85;
		color: var(--c-body);
		margin-bottom: 8px;
	}

	/* Blockquotes */
	.article-body :global(blockquote) {
		border-left: 3px solid var(--c-primary);
		padding-left: 20px;
		margin: 24px 0;
		color: var(--c-body);
		font-style: italic;
	}

	/* Links */
	.article-body :global(a) {
		color: var(--c-primary);
		text-decoration: none;
		font-weight: 500;
	}

	.article-body :global(a:hover) {
		text-decoration: underline;
	}

	/* Tables */
	.article-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 24px 0;
	}

	.article-body :global(th),
	.article-body :global(td) {
		padding: 12px;
		border: 1px solid var(--c-hairline);
		text-align: left;
	}

	.article-body :global(th) {
		background: var(--c-surface-card);
		font-weight: 600;
		color: var(--c-ink);
	}

	/* Article Footer */
	.article-footer {
		margin-top: 56px;
		padding-top: 32px;
		border-top: 1px solid var(--c-hairline-soft);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--c-primary);
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 500;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--c-primary-active);
	}

	.back-icon {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.back-link:hover .back-icon {
		transform: translateX(-4px);
	}

	/* Article Layout */
	.article-layout {
		display: grid;
		grid-template-columns: 260px 1fr 220px;
		gap: 0;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 24px 64px;
		align-items: start;
	}

	/* Left Sidebar */
	.sidebar-left {
		position: sticky;
		top: var(--header-height);
		height: calc(100vh - var(--header-height));
		overflow: hidden; /* internal scroll handled by ArticleList */
		padding-right: 32px;
		border-right: 1px solid var(--c-hairline-soft);
	}

	/* Right Sidebar */
	.sidebar-right {
		position: sticky;
		top: calc(var(--header-height) + 32px);
		height: fit-content;
		max-height: calc(100vh - var(--header-height) - 64px);
		overflow-y: auto;
		padding-left: 32px;
		scrollbar-width: none;
		border-left: 1px solid var(--c-hairline-soft);
	}

	.sidebar-right::-webkit-scrollbar {
		display: none;
	}

	/* Main Content */
	.article-main {
		min-width: 0;
		padding: 40px 48px 0;
	}

	/* Responsive */
	@media (max-width: 1200px) {
		.article-layout {
			grid-template-columns: 240px 1fr;
		}

		.sidebar-right {
			display: none;
		}
	}

	@media (max-width: 900px) {
		.article-layout {
			grid-template-columns: 1fr;
			padding: 0 16px 48px;
		}

		.sidebar-left {
			position: static;
			height: auto;
			overflow: visible;
			border-right: none;
			border-bottom: 1px solid var(--c-hairline-soft);
			padding-right: 0;
			padding-bottom: 24px;
			margin-bottom: 8px;
			order: 2;
		}

		.article-main {
			order: 1;
			padding: 32px 0 0;
		}
	}

	@media (max-width: 768px) {
		.article-hero {
			padding: 36px 16px 28px;
		}

		.article-meta {
			flex-wrap: wrap;
		}

		.article-body :global(h2) {
			font-size: 1.375rem;
		}

		.article-body :global(h3) {
			font-size: 1.125rem;
		}
	}
</style>
