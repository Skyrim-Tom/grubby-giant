---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const title = "文章";
const description = "技术文章、教程与生活分享";

const allPosts = await getCollection('posts');

const posts = allPosts.sort((a, b) =>
	new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = ["全部", ...new Set(posts.map(post => post.data.category))];

function formatDate(date: Date) {
	return new Date(date).toISOString().split('T')[0];
}
---

<Layout title={title} description={description}>
<div class="posts-page">

	<!-- ══ 页面 Hero 头部 ══ -->
	<div class="page-header">
		<div class="page-header-inner">
			<div class="page-eyebrow">
				<span class="eyebrow-mark" aria-hidden="true">✦</span>
				<span>ARTICLES</span>
			</div>
			<h1 class="page-title">文章列表</h1>
			<p class="page-desc">{posts.length} 篇文章，记录技术探索与生活点滴</p>
		</div>
	</div>

	<!-- ══ 文章内容区 ══ -->
	<div class="posts-content">

		<!-- 分类筛选栏 -->
		<div class="filter-bar">
			{categories.map((category) => (
				<button
					class={`filter-btn ${category === '全部' ? 'active' : ''}`}
					data-category={category}
					onclick={`filterByCategory('${category}')`}
				>
					{category}
				</button>
			))}
		</div>

		<!-- 文章列表 -->
		<div class="posts-list" id="posts-list">
			{posts.map((post, index) => (
				<article
					class="post-item"
					data-category={post.data.category}
				>
					<div class="post-meta-row">
						<span class="post-category-badge">{post.data.category}</span>
						<span class="post-dot" aria-hidden="true"></span>
						<time class="post-date">{formatDate(post.data.pubDate)}</time>
						<span class="post-dot" aria-hidden="true"></span>
						<span class="post-readtime">{post.data.readTime}阅读</span>
					</div>
					<h2 class="post-title">
						<a href={`/posts/${post.id}`}>
							<span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							{post.data.title}
						</a>
					</h2>
					<p class="post-excerpt">{post.data.description}</p>
					<div class="post-footer">
						<div class="post-tags">
							{post.data.tags.slice(0, 3).map((tag: string) => (
								<span class="post-tag">{tag}</span>
							))}
						</div>
						<a href={`/posts/${post.id}`} class="read-more">
							阅读文章
							<svg class="arrow-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>

		<!-- 空状态 -->
		<div class="no-posts" id="no-posts" style="display: none;">
			<svg class="no-posts-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
			</svg>
			<p>没有找到相关文章</p>
			<button class="clear-filter-btn" onclick="clearFilter()">清除筛选</button>
		</div>

	</div>
</div>
</Layout>

<style>
/* ══ 页面框架 ══ */
.posts-page {
	min-height: calc(100vh - var(--header-height));
}

/* ══ 页面 Hero ══ */
.page-header {
	padding: 72px 24px 48px;
	border-bottom: 1px solid var(--c-hairline-soft);
}

.page-header-inner {
	max-width: 800px;
	margin: 0 auto;
}

.page-eyebrow {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	font-size: 0.6875rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	color: var(--c-muted);
	margin-bottom: 16px;
}

.eyebrow-mark {
	color: var(--c-primary);
}

.page-title {
	font-family: var(--font-display);
	font-size: clamp(2rem, 5vw, 3.25rem);
	font-weight: 400;
	letter-spacing: -0.04em;
	color: var(--c-ink);
	line-height: 1.1;
	margin-bottom: 14px;
}

.page-desc {
	font-size: 1rem;
	color: var(--c-body);
	line-height: 1.7;
}

/* ══ 内容区 ══ */
.posts-content {
	max-width: 800px;
	margin: 0 auto;
	padding: 40px 24px 80px;
}

/* ══ 分类筛选栏 ══ */
.filter-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin-bottom: 40px;
}

.filter-btn {
	padding: 5px 14px;
	border: 1px solid var(--c-hairline);
	background: transparent;
	color: var(--c-muted);
	font-family: var(--font-body);
	font-size: 0.875rem;
	font-weight: 500;
	border-radius: 9999px;
	cursor: pointer;
	transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.filter-btn:hover {
	background: var(--c-surface-card);
	color: var(--c-ink);
	border-color: var(--c-hairline-soft);
}

.filter-btn.active {
	background: var(--c-primary);
	color: #fff;
	border-color: var(--c-primary);
}

/* ══ 文章列表 ══ */
.posts-list {
	display: flex;
	flex-direction: column;
}

.post-item {
	padding: 36px 0;
	border-bottom: 1px solid var(--c-hairline-soft);
}

.post-item:first-child {
	padding-top: 0;
}

.post-meta-row {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-bottom: 12px;
}

.post-category-badge {
	font-size: 0.6875rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 1px;
	color: var(--c-primary);
}

.post-dot {
	width: 3px;
	height: 3px;
	border-radius: 50%;
	background: var(--c-muted);
	flex-shrink: 0;
}

.post-date,
.post-readtime {
	font-size: 0.8125rem;
	color: var(--c-muted);
}

.post-title {
	font-family: var(--font-display);
	font-size: 1.75rem;
	font-weight: 500;
	line-height: 1.2;
	letter-spacing: -0.035em;
	margin-bottom: 12px;
}

.post-title a {
	color: var(--c-ink);
	text-decoration: none;
	display: flex;
	align-items: baseline;
	gap: 14px;
	transition: color 0.2s;
}

.post-title a:hover {
	color: var(--c-primary);
}

.post-number {
	font-family: var(--font-mono);
	font-size: 0.875rem;
	font-weight: 400;
	color: var(--c-muted);
	flex-shrink: 0;
	line-height: 1;
}

.post-title a:hover .post-number {
	color: var(--c-primary);
}

.post-excerpt {
	font-size: 0.9375rem;
	color: var(--c-body);
	line-height: 1.75;
	margin-bottom: 16px;
}

.post-footer {
	display: flex;
	justify-content: space-between;
	align-items: center;
	flex-wrap: wrap;
	gap: 12px;
}

.post-tags {
	display: flex;
	gap: 7px;
	flex-wrap: wrap;
}

.post-tag {
	padding: 3px 10px;
	background: var(--c-surface-card);
	border-radius: 9999px;
	font-size: 0.8125rem;
	font-weight: 500;
	color: var(--c-muted);
}

.read-more {
	display: inline-flex;
	align-items: center;
	gap: 5px;
	color: var(--c-primary);
	text-decoration: none;
	font-size: 0.875rem;
	font-weight: 500;
	transition: gap 0.2s;
}

.read-more:hover {
	gap: 9px;
}

/* ══ 空状态 ══ */
.no-posts {
	text-align: center;
	padding: 80px 20px;
	color: var(--c-body);
}

.no-posts-icon {
	width: 52px;
	height: 52px;
	margin: 0 auto 16px;
	display: block;
	opacity: 0.3;
}

.no-posts p {
	font-size: 1rem;
	margin-bottom: 20px;
}

.clear-filter-btn {
	padding: 10px 24px;
	background: var(--c-primary);
	border: none;
	border-radius: 8px;
	color: #fff;
	font-family: var(--font-body);
	font-size: 0.875rem;
	font-weight: 500;
	cursor: pointer;
	transition: background 0.2s;
}

.clear-filter-btn:hover {
	background: var(--c-primary-active);
}

/* ══ 响应式 ══ */
@media (max-width: 768px) {
	.page-header {
		padding: 48px 16px 32px;
	}

	.posts-content {
		padding: 32px 16px 64px;
	}

	.post-title {
		font-size: 1.375rem;
	}

	.post-number {
		display: none;
	}

	.post-footer {
		flex-direction: column;
		align-items: flex-start;
	}
}
</style>

<script is:inline>
	let activeCategory = '全部';

	function filterByCategory(category) {
		activeCategory = category;
		updateUI();
	}

	function clearFilter() {
		activeCategory = '全部';
		updateUI();
	}

	function updateUI() {
		const posts        = document.querySelectorAll('.post-item');
		const filterBtns   = document.querySelectorAll('.filter-btn');
		const noPosts      = document.getElementById('no-posts');
		const postsList    = document.getElementById('posts-list');

		// 更新按钮激活态
		filterBtns.forEach(btn => {
			btn.classList.toggle('active', btn.dataset.category === activeCategory);
		});

		// 显隐文章
		let visible = 0;
		posts.forEach(post => {
			const show = activeCategory === '全部' || post.dataset.category === activeCategory;
			post.style.display = show ? '' : 'none';
			if (show) visible++;
		});

		postsList.style.display = visible === 0 ? 'none' : '';
		noPosts.style.display   = visible === 0 ? 'block' : 'none';

		// 重排序号
		if (visible > 0) {
			let idx = 1;
			posts.forEach(post => {
				if (post.style.display !== 'none') {
					const num = post.querySelector('.post-number');
					if (num) num.textContent = String(idx++).padStart(2, '0');
				}
			});
		}
	}
</script>
